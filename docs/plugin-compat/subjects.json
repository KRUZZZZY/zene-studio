{
 "fixtures": [
  {
   "test": "ControlDeviceCatalogueTest",
   "what": "the in-tree VST3 and CLAP test modules (tests/data/vst3-test-instrument, the CLAP test modules) through plugin.list and plugin.load"
  },
  {
   "test": "Vst3InstrumentTest, Vst3HostTest",
   "what": "the MIT VST3 fixture instrument: MIDI event path, allocation-free process, host chunking"
  },
  {
   "test": "PluginNativeEditorTest",
   "what": "the native editor window around a plug-in view, with fake editor hooks - not a real plug-in editor"
  },
  {
   "test": "Lv2StateTest",
   "what": "the LV2 state interface against a test bundle"
  },
  {
   "test": "ControlSocketIntegration",
   "what": "the control-socket transcripts that save and load a hosted device state against the fixture modules"
  },
  {
   "test": "ClapHostTest, ClapEffectIntegrationTest",
   "what": "the in-tree CLAP gain fixture's editor on X11, Windows (win32) and macOS (cocoa): open, host and plug-in resize, close, reopen, the refusal naming platform and window API, and the editor button's refusal line (Q050-490)"
  },
  {
   "test": "Vst3EditorTest",
   "what": "the MIT VST3 fixture's editor (built on Linux, Windows and macOS) as X11EmbedWindowID, HWND and NSView: open, host and plug-in resize, close, reopen, the refusal naming platform and platform type, editor_scale per platform (Q050-490)"
  }
 ],

{
  "id": "comp/meter-pdc-0001",
  "scope": "comp",
  "seed": 5000,
  "groups": [
    "clip",
    "comp",
    "mastering",
    "meter",
    "note",
    "pdc",
    "track"
  ],
  "steps": [
    {
      "cmd": "track.add",
      "args": {
        "type": "instrument",
        "name": "CompBot"
      },
      "bind": {
        "track0": "track"
      },
      "expect": {
        "clip_count": 0,
        "index": 4,
        "muted": false,
        "soloed": false,
        "track_count": 5,
        "type": "instrument",
        "visible": true
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "clip.add",
      "args": {
        "track": "@id:track0",
        "position": 0,
        "length": 1920
      },
      "bind": {
        "track1": "track",
        "clip0": "clip"
      },
      "expect": {
        "auto_resize": false,
        "muted": false,
        "note_count": 0
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "note.add",
      "args": {
        "clip": "@id:clip0",
        "key": 60,
        "position": 0,
        "length": 480,
        "velocity": 100
      },
      "bind": {
        "clip1": "clip",
        "note0": "note"
      },
      "expect": {
        "index": 0,
        "note_count": 1
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "comp.get_state",
      "args": {
        "track": "@id:track0"
      },
      "bind": {
        "track2": "track"
      },
      "expect": {
        "lane_count": 0,
        "take_count": 0
      },
      "expect_len": {
        "lanes": 0
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "comp.lane_add",
      "args": {
        "track": "@id:track0",
        "name": "L1"
      },
      "bind": {
        "track3": "track"
      },
      "expect": {
        "lane_count": 1
      },
      "expect_len": {
        "lanes": 1
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "comp.lane_list",
      "args": {
        "track": "@id:track0"
      },
      "expect": {
        "count": 1
      },
      "expect_len": {
        "tracks": 1
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "comp.select",
      "args": {
        "track": "@id:track0",
        "lane": 0,
        "begin": 0,
        "end": 480
      },
      "bind": {
        "track4": "track"
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "comp.assign",
      "args": {
        "clip": "@id:clip0",
        "lane": 0
      },
      "expect_error": "refused",
      "note": "measured refusal refused: take lanes carry audio takes in this release; clip-10 is a midiclip clip (docs/COMPING.md)"
    },
    {
      "cmd": "comp.rebuild",
      "args": {
        "track": "@id:track0"
      },
      "bind": {
        "track5": "track"
      },
      "expect": {
        "segments_after": 1,
        "segments_before": 1
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "comp.get_state",
      "args": {
        "track": "@id:track0"
      },
      "bind": {
        "track6": "track"
      },
      "expect": {
        "lane_count": 1,
        "take_count": 1
      },
      "expect_len": {
        "lanes": 1
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "comp.lane_remove",
      "args": {
        "track": "@id:track0",
        "lane": 0
      },
      "bind": {
        "track7": "track"
      },
      "expect": {
        "lane_count": 0
      },
      "expect_len": {
        "lanes": 0
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "meter.arm",
      "args": {
        "enabled": true
      },
      "bind": {
        "note1": "note"
      },
      "expect": {
        "armed": true
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "meter.get_state",
      "bind": {
        "note2": "note"
      },
      "expect": {
        "armed": true
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "meter.arm",
      "args": {
        "enabled": false
      },
      "bind": {
        "note3": "note"
      },
      "expect": {
        "armed": false
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "pdc.report",
      "bind": {
        "note4": "note",
        "ch0": "channels[0].id"
      },
      "expect_len": {

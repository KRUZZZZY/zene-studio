      "note": "measured refusal invalid_args: a channel cannot route to itself"
    },
    {
      "cmd": "control.undo",
      "expect": {
        "can_redo": true,
        "can_undo": true,
        "undone": true
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "mixer.remove_channel",
      "args": {
        "channel": "@id:channel1"
      },
      "expect": {
        "count": 2
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "mixer.get_state",
      "bind": {
        "ch2": "channels[0].id"
      },
      "expect": {
        "count": 2
      },
      "expect_len": {
        "channels": 2
      },
      "note": "measured ok on the frozen binary"

        "clip_count": 3,
        "track_count": 5
      },
      "expect_len": {
        "clips": 3,
        "tracks": 5
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "clip.delete",
      "args": {
        "clip": "@id:clip0"
      },
      "bind": {
        "track2": "track"
      },
      "expect": {
        "dry_run": false
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "arrangement.get_state",
      "expect": {
        "clip_count": 2,
        "track_count": 5
      },
      "expect_len": {
        "clips": 2,
        "tracks": 5
      },

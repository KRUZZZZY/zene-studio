        "clip": "@id:clip0",
        "length": 3840
      },
      "bind": {
        "clip2": "clip"
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "clip.split",
      "args": {
        "clip": "@id:clip0",
        "position": 1440
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "clip.slip",
      "args": {
        "clip": "@id:clip0",
        "offset": 96
      },
      "bind": {
        "clip3": "clip"
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "clip.trim",
      "args": {
        "clip": "@id:clip0",
        "start": 0,
        "end": 960
      },
      "bind": {
        "clip4": "clip"
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "clip.duplicate",
      "args": {
        "clip": "@id:clip0",
        "position": 0
      },
      "bind": {
        "clip5": "clip"
      },
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "clip.crossfade",
      "args": {
        "in": "@id:clip0",

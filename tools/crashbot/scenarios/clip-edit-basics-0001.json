{
  "id": "clip/edit-basics-0001",
  "scope": "clip",
  "seed": 5000,
  "groups": [
    "arrangement",
    "clip",
    "control",
    "track"
  ],
  "steps": [
    {
      "cmd": "control.version",
      "note": "measured ok on the frozen binary"
    },
    {
      "cmd": "track.add",
      "args": {
        "type": "instrument",
        "name": "ClipBot"
      },
      "bind": {
        "track0": "track"
      },
      "expect": {
        "clip_count": 0,

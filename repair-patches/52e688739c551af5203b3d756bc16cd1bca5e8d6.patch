+	# warn_unused_result, and (void) does not silence -Wunused-result there - hosted
+	# linux-arm64 stopped on MountNamespaceTestSupport.h:78/110. Compile the real helper
+	# header in a used translation unit with the hosted configuration's flags; the probe's
+	# controls prove it rejects a discarded result and accepts a checked one.
+	if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+		add_test(NAME Train39-unused-result COMMAND ${PYTHON3_EXECUTABLE}
+			${CMAKE_CURRENT_SOURCE_DIR}/train-39-portability-check.py unused-result
+			--source-root ${CMAKE_SOURCE_DIR}
+			--cxx ${CMAKE_CXX_COMPILER}
+			--qt-include ${Qt${QT_VERSION_MAJOR}Core_INCLUDE_DIRS})
+		set_tests_properties(Train39-unused-result PROPERTIES TIMEOUT 120)
+	endif()
 	execute_process(COMMAND pkg-config --exists Qt5Widgets Qt5Xml Qt5Network
 		RESULT_VARIABLE TRAIN39_HAS_QT5 OUTPUT_QUIET ERROR_QUIET)
 	if(TRAIN39_HAS_QT5 EQUAL 0 AND TARGET carlabase)
diff --git a/tests/Qt5QListApiCheck.py b/tests/Qt5QListApiCheck.py
new file mode 100644
index 0000000000..d359e972ee
--- /dev/null
+++ b/tests/Qt5QListApiCheck.py
@@ -0,0 +1,425 @@
+#!/usr/bin/env python3
+"""Fail when the Eq plug-in uses QList APIs that Qt 5 does not declare.
+
+Cluster ci-151e338efff6843e (2026-11-14), hosted `build / windows-arm64` job: that job
+builds against MSYS2's clangarm64 Qt 5.15, where QList is still the node-based Qt 4
+container. It has no `QList(count, value)` constructor (that one is QVector's on Qt 5)
+and no `data()`/`constData()` accessor, so
+
+    plugins/Eq/EqSpectrumView.cpp:272:  m_spectrumBands( MAX_BANDS, 0.f )
+    plugins/Eq/EqSpectrumView.cpp:296:  copySpectrum( m_spectrumBands.data(), energy )
+    plugins/Eq/EqSpectrumView.cpp:315:  const float *bands = m_spectrumBands.data();
+
+stopped the whole build:
+
+    error: no matching constructor for initialization of 'QList<float>'
+    note: candidate template ignored: deduced conflicting types for parameter
+          'InputIterator' ('int' vs. 'float')
+    error: no member named 'data' in 'QList<float>'
+
+Qt 6 made QList the contiguous container, gave it both the size+value constructor and
+data(), and made QVector an alias of QList - so every Qt 6 host here compiles the same
+lines. QVector is the spelling with the size+value constructor and data() on BOTH:
+Qt 5's QVector declares them, Qt 6's QVector is QList. It is the portable container for
+the spectrum snapshot.
+
+The check has two deterministic halves:
+
+  * a source scan of plugins/Eq for a QList-typed name used with `.data()`/`.constData()`
+    or constructed with two top-level arguments. It reads sources only, so it is red on
+    the Qt 6 hosts where the defect compiles.
+  * a compile probe: when pkg-config finds a Qt 5 tree, every hand-written plugins/Eq
+    translation unit of build/compile_commands.json is compiled `-fsyntax-only` against
+    those Qt 5 headers, which is the hosted job's compiler input. Before the fix that is
+    the hosted failure; after it, all are clean.
+
+Both halves are proved able to fail by this file's own red/green fixtures, and the probe
+reports itself skipped (never passed) when the host has no Qt 5.
+
+Usage:
+  Qt5QListApiCheck.py [--root DIR] [--build-dir DIR] [--cxx CXX]
+  Qt5QListApiCheck.py --self-test
+
+Exit codes: 0 = clean, 1 = finding (or a failed fixture), 2 = usage error.
+"""
+
+import argparse
+import json
+import os
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+PLUGIN_DIR = "plugins/Eq"
+SOURCE_SUFFIXES = (".h", ".hpp", ".hxx", ".cpp", ".cxx", ".cc")
+
+# Comments, string and char literals are blanked before the shape scan (line numbers kept).
+NON_CODE = re.compile(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'', re.S)
+QLIST = re.compile(r"\bQList\s*<")
+DECLARATOR = re.compile(r"\s+([A-Za-z_][A-Za-z0-9_]*)")
+DATA_USE = r"\b%s\s*(?:->|\.)\s*(?:constData|data)\s*\("
+CONSTRUCTION = r"\b%s\s*\("
+
+# A Qt 5 tree must reject the QList take and accept the QVector one.
+BAD_PROBE = """\
+#include <QList>
+int main()
+{
+	QList<float> bands(8, 0.f);
+	return bands.data() == nullptr;
+}
+"""
+GOOD_PROBE = """\
+#include <QVector>
+int main()
+{
+	QVector<float> bands(8, 0.f);
+	return bands.data() == nullptr;
+}
+"""
+
+# The source scan must flag the QList member and not the QVector one.
+FIXTURE_BAD = """\
+#include <QList>
+struct View
+{
+	QList<float> m_spectrumBands;
+	View() : m_spectrumBands(4, 0.f) {}
+	float* bands() { return m_spectrumBands.data(); }
+};
+"""
+FIXTURE_GOOD = """\
+#include <QVector>
+struct View
+{
+	QVector<float> m_spectrumBands;
+	View() : m_spectrumBands(4, 0.f) {}
+	float* bands() { return m_spectrumBands.data(); }
+};
+"""
+
+QT_MODULES = {"QtCore", "QtGui", "QtWidgets", "QtXml", "QtSvg", "QtNetwork", "QtDBus", "QtTest"}
+RANGE_MARKERS = (".begin()", ".end()", ".cbegin()", ".cend()", "nullptr", "NULL")
+
+
+def blank_non_code(text):
+	"""Comments and literals become spaces; every newline and offset is kept."""
+	return NON_CODE.sub(lambda match: re.sub(r"[^\n]", " ", match.group(0)), text)
+
+
+def skip_template(text, start):
+	"""Index of the '>' closing the '<' at @a start, or -1."""
+	depth = 0
+	for index in range(start, len(text)):
+		if text[index] == "<":
+			depth += 1
+		elif text[index] == ">":
+			depth -= 1
+			if depth == 0:
+				return index
+	return -1
+
+
+def matching_paren(text, start):
+	"""Index of the ')' closing the '(' at @a start, or -1."""
+	depth = 0
+	for index in range(start, len(text)):
+		if text[index] == "(":
+			depth += 1
+		elif text[index] == ")":
+			depth -= 1
+			if depth == 0:
+				return index
+	return -1
+
+
+def split_arguments(text):
+	"""Top-level comma-separated arguments of an argument list, whitespace-stripped."""
+	parts, depth, current = [], 0, ""
+	for char in text:
+		if char in "([{<":
+			depth += 1
+		elif char in ")]}>":
+			depth -= 1
+		if char == "," and depth == 0:
+			parts.append(current.strip())
+			current = ""
+		else:
+			current += char
+	parts.append(current.strip())
+	return parts
+
+
+def declared_qlist_names(text):
+	"""Names declared with QList<T> (members, locals and parameters)."""
+	names = set()
+	index = 0
+	while True:
+		match = QLIST.search(text, index)
+		if match is None:
+			return names
+		close = skip_template(text, match.end() - 1)
+		if close < 0:
+			return names
+		declarator = DECLARATOR.match(text, close + 1)
+		if declarator is not None:
+			names.add(declarator.group(1))
+		index = close + 1
+
+
+def line_of(text, offset):
+	return text.count("\n", 0, offset) + 1
+
+
+def data_findings(name, code, qlist_names):
+	findings = []
+	for qlist_name in sorted(qlist_names):
+		for match in re.finditer(DATA_USE % re.escape(qlist_name), code):
+			findings.append((name, line_of(code, match.start()),
+				"QList has no data() in Qt 5; use QVector"))
+	return findings
+
+
+def is_two_argument_construction(code, match):
+	"""Whether the call at @a match is `name(a, b)` with two plain top-level arguments."""
+	before = code[:match.start()].rstrip()
+	if not before or before[-1] not in ",:(":
+		return False
+	close = matching_paren(code, match.end() - 1)
+	after = code[close + 1:].lstrip() if close >= 0 else ""
+	if not after or after[0] not in ";{,":
+		return False
+	arguments = split_arguments(code[match.end():close])
+	if len(arguments) != 2:
+		return False
+	return not any(marker in argument for argument in arguments for marker in RANGE_MARKERS)
+
+
+def construction_findings(name, code, qlist_names):
+	findings = []
+	for qlist_name in sorted(qlist_names):
+		for match in re.finditer(CONSTRUCTION % re.escape(qlist_name), code):
+			if is_two_argument_construction(code, match):
+				findings.append((name, line_of(code, match.start()),
+					"QList(count, value) does not exist in Qt 5; use QVector"))
+	return findings
+
+
+def scan_text(name, text, qlist_names=None):
+	"""(path, line, what) for QList APIs Qt 5 does not declare.
+
+	@a qlist_names carries the declarations of the whole component, so a member declared
+	in a header is still recognised where the implementation uses it.
+	"""
+	code = blank_non_code(text)
+	if qlist_names is None:
+		qlist_names = declared_qlist_names(code)
+	return (data_findings(name, code, qlist_names)
+		+ construction_findings(name, code, qlist_names))
+
+
+def read_text(path):
+	try:
+		with open(path, encoding="utf-8", errors="replace") as handle:
+			return blank_non_code(handle.read())
+	except OSError:
+		return None
+
+
+def scan_plugin(root):
+	"""The whole plug-in scanned as one component, so header declarations reach their uses."""
+	directory = os.path.join(root, PLUGIN_DIR)
+	if not os.path.isdir(directory):
+		return []
+	codes = {PLUGIN_DIR + "/" + entry: read_text(os.path.join(directory, entry))
+		for entry in sorted(os.listdir(directory)) if entry.endswith(SOURCE_SUFFIXES)}
+	codes = {name: code for name, code in codes.items() if code is not None}
+	qlist_names = set()
+	for code in codes.values():
+		qlist_names |= declared_qlist_names(code)
+	findings = []
+	for name, code in codes.items():
+		findings += scan_text(name, code, qlist_names)
+	return findings
+
+
+def self_test():
+	failures = []
+	if not scan_text("fixture-bad.cpp", FIXTURE_BAD):
+		failures.append("the scan did not report the QList<float>(count, value) fixture")
+	if scan_text("fixture-good.cpp", FIXTURE_GOOD):
+		failures.append("the scan reported the QVector<float> fixture")
+	return failures
+
+
+def run(command, cwd=None, timeout=300):
+	try:
+		return subprocess.run(command, cwd=cwd, capture_output=True, text=True, timeout=timeout)
+	except (OSError, subprocess.SubprocessError):
+		return None
+
+
+def qt5_flags():
+	"""Compile flags of a Qt 5 development tree, or None when pkg-config has none."""
+	if not shutil.which("pkg-config"):
+		return None
+	if run(["pkg-config", "--exists", "Qt5Widgets"]).returncode != 0:
+		return None
+	cflags = run(["pkg-config", "--cflags", "Qt5Widgets", "Qt5Xml", "Qt5Network"])
+	if cflags is None or cflags.returncode != 0:
+		return None
+	return shlex.split(cflags.stdout)
+
+
+def compile_probe(cxx, flags, workdir):
+	"""Only a Qt 5 tree must reject BAD_PROBE and accept GOOD_PROBE; None when it accepts both."""
+	probes = []
+	for name, text in (("bad.cpp", BAD_PROBE), ("good.cpp", GOOD_PROBE)):
+		path = os.path.join(workdir, name)
+		with open(path, "w", encoding="utf-8") as handle:
+			handle.write(text)
+		probes.append(run([cxx, "-std=gnu++20", "-fsyntax-only"] + flags + [path]))
+	if probes[0] is None or probes[0].returncode == 0:
+		return None
+	if probes[1] is None or probes[1].returncode != 0:
+		return "probe: the Qt 5 tree rejected QVector(count, value)"
+	return "probe: Qt 5 rejects QList(count, value).data() and accepts QVector"
+
+
+def is_qt6_include(directory):
+	parts = [p for p in re.split(r"[\\/]+", directory.rstrip("\\/")) if p]
+	return "qt6" in parts or (parts and parts[-1] in QT_MODULES and any("qt6" in p for p in parts))
+
+
+def qt5_command(arguments, flags, source):
+	"""A recorded Qt 6 compile line retargeted at the Qt 5 headers."""
+	out = []
+	index = 0
+	while index < len(arguments):
+		argument = arguments[index]
+		consumes_value = index + 1 < len(arguments) and argument in ("-isystem", "-I", "-o", "-c")
+		if argument in ("-o", "-c"):
+			index += 2
+		elif consumes_value and argument in ("-isystem", "-I") and is_qt6_include(arguments[index + 1]):
+			index += 2
+		elif consumes_value and argument in ("-isystem", "-I"):
+			out += [argument, arguments[index + 1]]
+			index += 2
+		else:
+			out.append(argument)
+			index += 1
+	return out + flags + ["-fsyntax-only", source]
+
+
+def source_file(entry, root):
+	"""The entry's source path when it is a hand-written Eq file, else None.
+
+	Only the checked-in plugins/Eq sources are tested. The generated moc_*/qrc_* units live
+	in the build tree and are produced by the Qt 6 moc of this build, so compiling them
+	against Qt 5 headers would test this build's own generator, not the product source.
+	"""
+	source = entry.get("file", "").replace("\\", "/")
+	if not source.endswith(SOURCE_SUFFIXES):
+		return None
+	absolute = source if os.path.isabs(source) else os.path.join(entry.get("directory", root), source)
+	absolute = os.path.abspath(os.path.normpath(absolute))
+	plugin_root = os.path.join(os.path.abspath(root), PLUGIN_DIR) + os.sep
+	if not absolute.startswith(plugin_root):
+		return None
+	return absolute if os.path.isfile(absolute) else None
+
+
+def entries_of(database):
+	with open(database, encoding="utf-8", errors="replace") as handle:
+		return json.load(handle)
+
+
+def probe_diagnostic(result):
+	"""The error/note lines of a failed probe, bounded."""
+	return "\n".join(line for line in (result.stdout + result.stderr).splitlines()
+		if "error:" in line or "note:" in line)[:2000]
+
+
+def probe_entry(entry, root, flags):
+	source = source_file(entry, root)
+	if source is None:
+		return None
+	arguments = entry.get("command") and shlex.split(entry["command"]) or list(entry.get("arguments") or [])
+	result = run(qt5_command(arguments, flags, source), entry.get("directory") or root)
+	if result is None:
+		return f"{source}: the Qt 5 probe could not run"
+	if result.returncode != 0:
+		return f"{source}: Qt 5 rejected it\n{probe_diagnostic(result)}"
+	return None
+
+
+def probe_translation_units(root, build_dir, flags):
+	"""Compile every hand-written Eq translation unit against Qt 5."""
+	database = os.path.join(build_dir, "compile_commands.json")
+	if not os.path.isfile(database):
+		return [f"no compile database at {database}"]
+	results = [probe_entry(entry, root, flags) for entry in entries_of(database)]
+	failures = [result for result in results if result]
+	if not results:
+		failures.append(f"the compile database records no {PLUGIN_DIR} translation unit")
+	return failures
+
+
+def report(findings):
+	for name, line, what in findings:
+		print(f"{name}:{line}: {what}" if isinstance(line, int) else f"{name}: {what}")
+	print(f"FAIL: {len(findings)} Qt-5-incompatible QList use(s)")
+	return 1
+
+
+def check(root, build_dir, cxx, workdir):
+	"""Every finding, with the source scan and the Qt 5 probe as independent halves."""
+	findings = scan_plugin(root)
+	flags = qt5_flags()
+	if flags is None:
+		print("probe: skipped (no Qt 5 development tree found)")
+		return findings
+	print(compile_probe(cxx, flags, workdir) or "probe: skipped (this Qt accepts the QList take)")
+	for failure in probe_translation_units(root, build_dir, flags):
+		headline, _, diagnostic = failure.partition("\n")
+		findings.append((headline, None, diagnostic))
+	return findings
+
+
+def main(argv):
+	parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+	parser.add_argument("--root", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+	parser.add_argument("--build-dir")
+	parser.add_argument("--cxx", default=os.environ.get("CXX") or shutil.which("c++") or "c++")
+	parser.add_argument("--self-test", action="store_true")
+	args = parser.parse_args(argv[1:])
+
+	failures = self_test()
+	for failure in failures:
+		print(f"SELF-TEST FAIL: {failure}")
+	if failures:
+		return 1
+	print("self-test: the QList fixture is flagged and the QVector fixture is not")
+	if args.self_test:
+		return 0
+	root = os.path.abspath(args.root)
+	if not os.path.isdir(root):
+		print(f"error: not a directory: {root}", file=sys.stderr)
+		return 2
+	build_dir = os.path.abspath(args.build_dir or os.path.join(root, "build"))
+	workdir = tempfile.mkdtemp(prefix="qt5-qlist-")
+	try:
+		findings = check(root, build_dir, args.cxx, workdir)
+	finally:
+		shutil.rmtree(workdir, ignore_errors=True)
+	if findings:
+		return report(findings)
+	print("PASS: the Eq plugin uses no QList API Qt 5 lacks, and every Eq translation unit compiles against Qt 5")
+	return 0
+
+
+if __name__ == "__main__":
+	sys.exit(main(sys.argv))
diff --git a/tests/crash-reporter-apple-signal-check.py b/tests/crash-reporter-apple-signal-check.py
new file mode 100644
index 0000000000..674d7be252
--- /dev/null
+++ b/tests/crash-reporter-apple-signal-check.py
@@ -0,0 +1,281 @@
+#!/usr/bin/env python3
+"""Regression for cluster ci-1e541b5d1279ed2d: the crash reporter's ARM/DISARM
+proof must compile against Apple's <signal.h>.
+
+The macos-arm64 build stopped at
+
+    tests/src/core/CrashReporterArmTest.cpp:81:16: error: exception specification
+    in declaration does not match previous declaration      (the test's sigaction interposer)
+    tests/src/core/CrashReporterArmTest.cpp:198:13: error: expected unqualified-id
+                                                            (::sigemptyset, a macro on Apple)
+
+and the sibling tests/src/core/CrashReporterTest.cpp:548 carried the same
+`::sigemptyset` spelling and had not been compiled yet when the job stopped.
+
+Why a probe.  This box is not Darwin, so the check compiles the two REAL
+translation units with the project's own recorded flags from
+build/compile_commands.json, under a model of the two Apple properties the test
+depends on:
+
+  1. sigaction() is declared WITHOUT an exception specification. glibc declares
+     it `noexcept (true)` through __THROW; the probe prepends a shadow
+     <sys/cdefs.h> that empties __THROW, which is exactly Apple's state (its
+     libc has no __THROW).  The shadow is only added when the host's own
+     declaration is noexcept, and a model assertion proves the change took.
+  2. sigemptyset() is a function-like MACRO. Apple's is `(*(set) = 0, 0)`; the
+     probe uses `(*(set) = {}, 0)` so the same macro also fits hosts whose
+     sigset_t is a struct. `::sigemptyset(...)` therefore cannot parse.
+
+Two fixtures keep the model honest and independent of the test sources: the
+pre-fix shape must FAIL under it, the fixed shape must PASS. A Clang-family
+compiler is required because that is what the hosted macOS job runs and it is
+the compiler that enforces the exception-specification match; GCC accepts the
+same redeclaration, so it cannot measure that half.
+
+Usage: crash-reporter-apple-signal-check.py --build-dir <build>
+       [--root <source>] [--cxx <clang>]
+
+Exit 0 only when the model is proven and both real translation units compile.
+"""
+
+import argparse
+import json
+import pathlib
+import shlex
+import subprocess
+import sys
+import tempfile
+
+TARGETS = (
+    "tests/src/core/CrashReporterArmTest.cpp",
+    "tests/src/core/CrashReporterTest.cpp",
+)
+
+# Flags the probe needs to reproduce the recorded compilation. Warning,
+# optimisation and dependency flags are deliberately dropped: this is a
+# syntax/portability probe, and the real build keeps every flag.
+JOINED_PREFIXES = ("-I", "-D", "-U", "-F")
+SPLIT_FLAGS = ("-isystem", "-iquote", "-isysroot", "-include", "-iframework", "-arch", "-target")
+JOINED_FLAGS = ("-std=", "--target=", "-mmacosx-version-min=", "-isysroot")
+STANDALONE_FLAGS = ("-fPIC", "-fPIE", "-pthread")
+
+APPLE_SIGNAL_H = """\
+#ifndef ZENE_TEST_SIMULATED_APPLE_SIGNAL_H
+#define ZENE_TEST_SIMULATED_APPLE_SIGNAL_H
+/* Model Apple's <signal.h> where the ARM/DISARM proof depends on it. */
+#include <signal.h>
+#include <csignal>
+#undef sigemptyset
+#define sigemptyset(set) (*(set) = {}, 0)
+#endif
+"""
+
+CDEFS_SHADOW = """\
+#ifndef ZENE_TEST_SIMULATED_APPLE_CDEFS_H
+#define ZENE_TEST_SIMULATED_APPLE_CDEFS_H
+/* Apple's libc has no __THROW; glibc's declares sigaction() noexcept through it. */
+#include_next <sys/cdefs.h>
+#undef __THROW
+#undef __THROWNL
+#define __THROW
+#define __THROWNL
+#endif
+"""
+
+MODEL_ASSERTION = """\
+#include <signal.h>
+#ifndef sigemptyset
+#error "the model must define sigemptyset as a macro"
+#endif
+static_assert(!noexcept(::sigaction(0, nullptr, nullptr)),
+	"the model must remove sigaction's exception specification");
+int main() { return 0; }
+"""
+
+OLD_SHAPE = """\
+#include <signal.h>
+extern "C" int sigaction(int signum, const struct sigaction* action,
+	struct sigaction* oldAction) noexcept
+{
+	(void)signum; (void)action; (void)oldAction; return 0;
+}
+int main()
+{
+	struct sigaction ignored{};
+	::sigemptyset(&ignored.sa_mask);
+	return 0;
+}
+"""
+
+NEW_SHAPE = """\
+#include <signal.h>
+extern "C" int sigaction(int signum, const struct sigaction* action,
+	struct sigaction* oldAction)
+	noexcept(noexcept(::sigaction(0, nullptr, nullptr)))
+{
+	(void)signum; (void)action; (void)oldAction; return 0;
+}
+int main()
+{
+	struct sigaction ignored{};
+	sigemptyset(&ignored.sa_mask);
+	return 0;
+}
+"""
+
+
+def run(command, cwd):
+    return subprocess.run(command, cwd=cwd, text=True, capture_output=True, check=False)
+
+
+def fail(message, result=None):
+    print("FAIL " + message)
+    if result is not None and (result.stdout or result.stderr):
+        print((result.stdout + result.stderr).strip()[:2000])
+    return False
+
+
+def is_clang(cxx):
+    result = run([cxx, "--version"], None)
+    return result.returncode == 0 and "clang" in result.stdout.lower()
+
+
+def host_sigaction_is_noexcept(cxx, temp):
+    source = temp / "host-noexcept.cpp"
+    source.write_text(
+        '#include <signal.h>\nstatic_assert(noexcept(::sigaction(0, nullptr, nullptr)), "noexcept");\n'
+        "int main() { return 0; }\n", encoding="utf-8")
+    result = run([cxx, "-std=c++20", "-fsyntax-only", str(source)], temp)
+    return result.returncode == 0
+
+
+def recorded_flags(entry):
+    arguments = entry.get("arguments")
+    if not arguments:
+        arguments = shlex.split(entry["command"])
+    flags, index = [], 1          # skip the compiler
+    while index < len(arguments):
+        argument = arguments[index]
+        index += 1
+        if argument in ("-c", "-o", "-MF", "-MT", "-MQ"):
+            index += 1           # the value of the pair
+            continue
+        if argument in SPLIT_FLAGS:
+            flags += [argument, arguments[index]]
+            index += 1
+            continue
+        if argument.startswith(JOINED_FLAGS) or argument.startswith(JOINED_PREFIXES):
+            flags.append(argument)
+            continue
+        if argument in STANDALONE_FLAGS:
+            flags.append(argument)
+    return flags
+
+
+def compile_probe(cxx, flags, overlay, source, temp):
+    command = [cxx, "-I", str(overlay), *flags,
+               "-include", str(overlay / "apple_signal.h"), "-fsyntax-only", str(source)]
+    return run(command, temp)
+
+
+def load_entries(commands, root):
+    """The recorded compile command of every target, keyed by repo-relative path."""
+    entries = {}
+    for entry in json.loads(commands.read_text(encoding="utf-8")):
+        try:
+            relative = pathlib.Path(entry["file"]).resolve().relative_to(root).as_posix()
+        except ValueError:
+            continue      # a generated or out-of-tree source is not one of the targets
+        if relative in TARGETS:
+            entries[relative] = entry
+    return entries
+
+
+def prepare_overlay(cxx, temp):
+    """Write the Apple model; empty __THROW only where the host declares it noexcept."""
+    overlay = temp / "apple"
+    (overlay / "sys").mkdir(parents=True)
+    (overlay / "apple_signal.h").write_text(APPLE_SIGNAL_H, encoding="utf-8")
+    if host_sigaction_is_noexcept(cxx, temp):
+        (overlay / "sys" / "cdefs.h").write_text(CDEFS_SHADOW, encoding="utf-8")
+    return overlay
+
+
+def preflight(args, root, build):
+    """The recorded commands to compile, or None after saying why they are unusable."""
+    commands = build / "compile_commands.json"
+    if not commands.is_file():
+        fail("no compile_commands.json at %s" % commands)
+        return None
+    if not is_clang(args.cxx):
+        fail("a Clang-family compiler is required (hosted macOS runs AppleClang); got %s" % args.cxx)
+        return None
+    entries = load_entries(commands, root)
+    missing = [target for target in TARGETS if target not in entries]
+    if missing:
+        fail("no recorded compile command for " + ", ".join(missing))
+        return None
+    return entries
+
+
+def require(cxx, overlay, source, temp, label, compiles):
+    """Compile one source under the model and require it to compile (or not)."""
+    result = compile_probe(cxx, [], overlay, source, temp)
+    if (result.returncode == 0) == compiles:
+        print("PASS " + label)
+        return True
+    return fail(label + (" but it must be rejected" if compiles else " but it must compile"), result)
+
+
+def model_checks(cxx, overlay, temp):
+    """The model is in force, and it separates the pre-fix shape from the fixed one."""
+    checks = []
+    assertion = temp / "model-assertion.cpp"
+    assertion.write_text(MODEL_ASSERTION, encoding="utf-8")
+    checks.append(require(cxx, overlay, assertion, temp,
+                          "the Apple signal model is in force", True))
+    for name, text, compiles in (("old", OLD_SHAPE, False), ("new", NEW_SHAPE, True)):
+        fixture = temp / ("fixture-%s.cpp" % name)
+        fixture.write_text(text, encoding="utf-8")
+        checks.append(require(cxx, overlay, fixture, temp,
+                              "%s shape under the model" % name, compiles))
+    return checks
+
+
+def target_checks(cxx, overlay, root, entries, temp):
+    """The two REAL translation units compile under Apple's <signal.h>."""
+    checks = []
+    for target in TARGETS:
+        result = compile_probe(cxx, recorded_flags(entries[target]),
+                               overlay, root / target, temp)
+        if result.returncode == 0:
+            print("PASS %s compiles under Apple's <signal.h>" % target)
+            checks.append(True)
+        else:
+            checks.append(fail("%s does not compile under Apple's <signal.h>" % target, result))
+    return checks
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--build-dir", type=pathlib.Path, required=True)
+    parser.add_argument("--root", type=pathlib.Path, default=pathlib.Path(__file__).resolve().parents[1])
+    parser.add_argument("--cxx", default="clang++")
+    args = parser.parse_args()
+    root, build = args.root.resolve(), args.build_dir.resolve()
+    entries = preflight(args, root, build)
+    if entries is None:
+        return 1
+
+    with tempfile.TemporaryDirectory(prefix="zene-apple-signal-") as directory:
+        temp = pathlib.Path(directory)
+        overlay = prepare_overlay(args.cxx, temp)
+        checks = model_checks(args.cxx, overlay, temp)
+        checks += target_checks(args.cxx, overlay, root, entries, temp)
+
+    print("RESULT %d/%d checks passed" % (sum(checks), len(checks)))
+    return 0 if all(checks) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/data/vcpkg-pcre2/builtin-portfile-177e817512.cmake b/tests/data/vcpkg-pcre2/builtin-portfile-177e817512.cmake

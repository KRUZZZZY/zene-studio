+		if (!match.hasMatch()) { continue; }
+		bool opens = false;
+		for (int j = i + 1; j < lines.size() && j <= i + 4; ++j)
+		{
+			opens = opens || lines.at(j).trimmed() == QLatin1String("{");
+		}
+		if (opens) { definitions.append(TopLevelDefinition{i, match.captured(1)}); }
+	}

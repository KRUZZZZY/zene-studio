@@ -0,0 +1,286 @@
+#!/usr/bin/env python3
+"""Compiler regressions for Qt5 JSON, Windows timeout, and Qt target usage."""
+
+# Copyright (c) 2026 Zene Studio contributors
+#
+# This file is part of LMMS - https://lmms.io
+#

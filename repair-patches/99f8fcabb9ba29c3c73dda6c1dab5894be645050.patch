+	pan->setValue(20.0f);
+	const QJsonObject args{{QStringLiteral("channel"), underTestChannel()},
+		{QStringLiteral("x_macro"), macroId(xMacro)}, {QStringLiteral("x_value"), 0.25},
+		{QStringLiteral("y_macro"), macroId(yMacro)}, {QStringLiteral("y_value"), 0.75}};

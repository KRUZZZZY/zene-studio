+	QVERIFY( Engine::getSong()->isContainerV2Project() );
+
+	Engine::getSong()->clearProject();
+	QVERIFY( !Engine::getSong()->isContainerV2Project() );
+	QVERIFY( run( QStringLiteral( "project.open" ), {{ QStringLiteral( "path" ), path }} ).ok );

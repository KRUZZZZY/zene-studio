+void ArrangerTimelineTest::initTestCase() {
+	QVERIFY(m_home.isValid());
+	guitest::startGui(m_home);
+	ControlRegistry::setReady(true);
+	getGUI()->mainWindow()->show();
+	getGUI()->songEditor()->parentWidget()->show();

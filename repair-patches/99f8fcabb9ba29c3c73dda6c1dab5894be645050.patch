+void ProjectContainerSaveTest::theSaveAsChoiceDecidesTheFormat() {
+	QTemporaryDir dir;
+	QVERIFY( dir.isValid() );
+	buildSession();
+	Song* song = Engine::getSong();
+
+	song->getSaveOptions().saveAsV2Container.setValue( true );

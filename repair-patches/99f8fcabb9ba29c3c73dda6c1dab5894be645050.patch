+	CollabClient client;
+	wire(client);
+	QSignalSpy applied(&client, &CollabClient::snapshotApplied);
+	Invite invite;
+	invite.address = QHostAddress(QHostAddress::LocalHost);
+	invite.port = host.port();
+	invite.key = key;

+// Each rendezvous is used once. The predicate keeps early arrivals blocked until
+// all three callers arrive, and tolerates spurious wakeups on older macOS too.
+class CallerRendezvous
+{
+public:
+	void arrive_and_wait()
+	{
+		std::unique_lock<std::mutex> lock{m_mutex};
+		if (--m_remaining == 0) { m_ready.notify_all(); }
+		else { m_ready.wait(lock, [this] { return m_remaining == 0; }); }
+	}
+private:
+	std::mutex m_mutex;
+	std::condition_variable m_ready;

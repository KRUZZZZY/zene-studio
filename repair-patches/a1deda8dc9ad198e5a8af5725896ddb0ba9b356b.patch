@@ -0,0 +1,35 @@
+// NeuralAmp harness CPU clock. GPL-2.0-or-later.
+#pragma once
+
+#include <stdexcept>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <ctime>
+#endif
+
+inline double namThreadCpuMicroseconds()
+{
+#ifdef _WIN32
+	FILETIME created{}, exited{}, kernel{}, user{};
+	if (!GetThreadTimes(GetCurrentThread(), &created, &exited, &kernel, &user))
+	{
+		throw std::runtime_error("GetThreadTimes failed");
+	}
+	const auto ticks = [](const FILETIME& time) {
+		return (static_cast<unsigned long long>(time.dwHighDateTime) << 32)
+			| time.dwLowDateTime;
+	};
+	return static_cast<double>(ticks(kernel) + ticks(user)) / 10.0;
+#else
+	timespec time{};
+	if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &time) != 0)
+	{
+		throw std::runtime_error("clock_gettime failed");
+	}
+	return time.tv_sec * 1e6 + time.tv_nsec / 1e3;
+#endif
+}

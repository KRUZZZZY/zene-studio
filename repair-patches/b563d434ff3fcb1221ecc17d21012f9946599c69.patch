 		QVERIFY(existingRowDelegate);
 		QVERIFY(model.insertRow(1));
-		QCOMPARE(view.itemDelegateForIndex(model.index(1, 0)), existingRowDelegate);
+		QCOMPARE(rowDelegate(view, model.index(1, 0)), existingRowDelegate);

+  ScriptClockTest.cpp:408:92: error: 'class QJsonValue' has no member named 'toInteger'
+  ScriptClockTest.cpp:415:69: error: 'class QJsonValue' has no member named 'toInteger'
+git apply build/fix-logs/fix.patch                                          # exit 0

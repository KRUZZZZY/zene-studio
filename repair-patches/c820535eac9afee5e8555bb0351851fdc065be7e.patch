index 0000000000..ac0651edaa
--- /dev/null
+++ b/tests/Qt5QJsonValueIntegerCheck.py
@@ -0,0 +1,280 @@
+#!/usr/bin/env python3
+"""Fail when ScriptClockTest reads JSON numbers through QJsonValue::toInteger.
+
+Cluster ci-bbbeb2c8d6e707a8, hosted `build / macos-x86_64` at
+dec3f1d45c62b26bce955875521780db173a0228: that job builds against Qt 5.15, where
+`QJsonValue` has no `toInteger` member (it is Qt 6 only), so
+
+    tests/src/core/ScriptClockTest.cpp:408 and :415
+        clock.scheduleState(id).value(QStringLiteral("source_bytes")).toInteger(-1)
+
+stopped the build:
+
+    error: no member named 'toInteger' in 'QJsonValue'
+
+The portable spelling is the project's `jsonInteger` adapter in
+include/DeprecationHelper.h, which keeps the Qt 6 whole-number semantics on Qt 5.
+
+The check has two deterministic halves:
+
+  * fixtures: a Qt 5 tree must reject a raw `QJsonValue::toInteger` call and accept
+    `jsonInteger`. A tree that accepts `toInteger`, or rejects the adapter, cannot
+    tell the trap from the fix and fails the check instead of passing it.
+  * the real translation unit: tests/src/core/ScriptClockTest.cpp is recompiled
+    `-fsyntax-only` through this build's compile_commands.json against the Qt 5
+    headers (and the Qt 5 moc), retargeting the recorded Qt include directories.
+    That is the hosted job's compiler input, so this check is the hosted build.
+
+The probe returns a dedicated skip code (77, mapped to CTest's Skipped) only when
+a Qt 5 prerequisite is absent: pkg-config finds no Qt 5 development tree or no Qt 5
+moc. The hosted macos-x86_64 job is Qt 5, so it is red there before the fix.
+
+Usage:
+  Qt5QJsonValueIntegerCheck.py [--root DIR] [--build-dir DIR] [--cxx CXX]
+  Qt5QJsonValueIntegerCheck.py --self-test
+
+Exit codes: 0 = clean, 1 = finding or unusable compatibility fixture, 2 = usage
+error, 77 = skipped (Qt 5 development tree or moc unavailable).
+"""
+
+import argparse
+import json
+import os
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TEST_SOURCE = "tests/src/core/ScriptClockTest.cpp"
+SKIP_RETURN_CODE = 77
+
+# Qt modules whose include directories must give way to the Qt 5 tree.
+QT_MODULES = {"qtcore", "qtgui", "qtwidgets", "qtxml", "qtnetwork", "qttest",
+              "qtsvg", "qtdbus", "qtconcurrent"}
+
+BAD_FIXTURE = """\
+#include <QJsonValue>
+
+int main()
+{
+    const QJsonValue value(14);
+    return static_cast<int>(value.toInteger(-1));
+}
+"""
+
+GOOD_FIXTURE = """\
+#include <QJsonValue>
+
+#include "DeprecationHelper.h"
+
+int main()
+{
+    const QJsonValue value(14);
+    return lmms::jsonInteger(value, -1) == 14 ? 0 : 1;
+}
+"""
+
+
+def run(command, cwd=None, timeout=600):
+    try:
+        return subprocess.run(command, cwd=cwd, capture_output=True, text=True,
+                              timeout=timeout)
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+
+def qt5_flags():
+    """Compile flags of a Qt 5 development tree, or None when pkg-config has none."""
+    if not shutil.which("pkg-config"):
+        return None
+    if run(["pkg-config", "--exists", "Qt5Widgets"]).returncode != 0:
+        return None
+    for packages in (["Qt5Widgets", "Qt5Xml", "Qt5Network", "Qt5Test"],
+                     ["Qt5Widgets", "Qt5Xml", "Qt5Network"],
+                     ["Qt5Widgets"]):
+        result = run(["pkg-config", "--cflags", *packages])
+        if result is not None and result.returncode == 0:
+            return shlex.split(result.stdout)
+    return None
+
+
+def qt5_moc():
+    """The Qt 5 moc, or None. A Qt 6 moc cannot pre-process a Qt 5 translation unit."""
+    result = run(["pkg-config", "--variable=host_bins", "Qt5Core"])
+    if result is not None and result.returncode == 0 and result.stdout.strip():
+        candidate = os.path.join(result.stdout.strip(), "moc")
+        if os.path.isfile(candidate):
+            version = run([candidate, "-v"])
+            if version is not None and version.stdout.strip().startswith("moc 5"):
+                return candidate
+    return None
+
+
+def compile_fixture(cxx, flags, workdir, name, text):
+    path = os.path.join(workdir, name)
+    with open(path, "w", encoding="utf-8") as handle:
+        handle.write(text)
+    return run([cxx, "-std=gnu++20", "-fPIC", "-fsyntax-only", *flags, path])
+
+
+def fixture_verdict(cxx, flags, workdir, include_dir):
+    """(usable, verdict) for the tree: usable only when it rejects BAD and accepts GOOD."""
+    bad = compile_fixture(cxx, [*flags, "-I" + include_dir], workdir, "bad.cpp", BAD_FIXTURE)
+    good = compile_fixture(cxx, [*flags, "-I" + include_dir], workdir, "good.cpp", GOOD_FIXTURE)
+    if bad is None or bad.returncode == 0:
+        return False, "no fixture"
+    if good is None or good.returncode != 0:
+        return False, "the Qt 5 tree rejects the jsonInteger adapter"
+    return True, "probe: Qt 5 rejects QJsonValue::toInteger and accepts jsonInteger"
+
+
+def compile_database(build):
+    path = os.path.join(build, "compile_commands.json")
+    if not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8", errors="replace") as handle:
+        entries = json.load(handle)
+    return entries if isinstance(entries, list) else None
+
+
+def entry_for(entries, root, relative):
+    wanted = os.path.realpath(os.path.join(root, relative))
+    for entry in entries:
+        if os.path.realpath(entry.get("file", "")) == wanted:
+            return entry
+    return None
+
+
+def is_qt_include(directory):
+    """True for any Qt include root, so the recorded Qt (5 or 6) cannot leak into the probe."""
+    parts = [part.lower() for part in re.split(r"[\\/]+", directory.rstrip("\\/")) if part]
+    for part in parts:
+        if part in QT_MODULES or part in {"qt", "qt5", "qt6"}:
+            return True
+        if part.startswith("qt") and part.endswith(".framework"):
+            return True
+    return False
+
+
+def qt5_command(entry, flags, extra):
+    """The recorded compile line retargeted at the Qt 5 headers, without -Werror."""
+    arguments = entry.get("arguments")
+    if arguments is None:
+        arguments = shlex.split(entry.get("command", ""))
+    out = []
+    index = 0
+    while index < len(arguments):
+        argument = arguments[index]
+        if argument in ("-o", "-c", "-MD", "-MMD", "-MP"):
+            index += 2 if argument in ("-o", "-c") else 1
+            continue
+        if argument in ("-isystem", "-I") and index + 1 < len(arguments):
+            if not is_qt_include(arguments[index + 1]):
+                out += [argument, arguments[index + 1]]
+            index += 2
+            continue
+        if argument == "-Werror":
+            index += 1
+            continue
+        out.append(argument)
+        index += 1
+    # The Qt 5 moc output must win over the recorded Qt 6 autogen directory, so the extra
+    # include directories go first.
+    return out[:1] + list(extra) + out[1:] + list(flags) + ["-fsyntax-only"]
+
+
+def probe_translation_unit(cxx, flags, root, build, moc, workdir):
+    entries = compile_database(build)
+    if entries is None:
+        return f"no compile database at {os.path.join(build, 'compile_commands.json')}"
+    entry = entry_for(entries, root, TEST_SOURCE)
+    if entry is None:
+        return f"{TEST_SOURCE}: no entry in the compile database"
+    source = os.path.realpath(os.path.join(root, TEST_SOURCE))
+    generated = os.path.join(workdir, "ScriptClockTest.moc")
+    made = run([moc, source, "-o", generated])
+    if made is None or made.returncode != 0:
+        return f"{TEST_SOURCE}: the Qt 5 moc failed"
+    command = qt5_command(entry, flags, ["-I" + workdir])
+    command.append(source)
+    result = run(command, cwd=entry.get("directory") or root)
+    if result is None:
+        return f"{TEST_SOURCE}: the Qt 5 compile probe could not run"
+    if result.returncode != 0:
+        diagnostic = "\n".join(line for line in (result.stdout + result.stderr).splitlines()
+                               if re.search(r"error:|note:", line))[:3000]
+        return f"{TEST_SOURCE}: Qt 5 rejected it\n{diagnostic}"
+    return None
+
+
+def self_test(cxx, flags, root):
+    """The fixtures must be distinguishable before the real translation unit is trusted."""
+    with tempfile.TemporaryDirectory(prefix="qt5-qjson-fixtures-") as workdir:
+        return fixture_verdict(cxx, flags, workdir, os.path.join(root, "include"))
+
+
+def run_self_test(cxx, root):
+    """The fixtures still need a Qt 5 tree; they prove the instrument, never the product."""
+    flags = qt5_flags()
+    if flags is None:
+        print("self-test: skipped (no Qt 5 development tree found)")
+        return SKIP_RETURN_CODE
+    usable, verdict = self_test(cxx, flags, root)
+    if not usable:
+        print(f"SELF-TEST FAIL: {verdict}")
+        return 1
+    print(verdict)
+    return 0
+
+
+def check_product(cxx, root, build):
+    """The fixture verdict, then the real translation unit when this host has Qt 5."""
+    flags = qt5_flags()
+    if flags is None:
+        print("probe: skipped (no Qt 5 development tree found)")
+        return SKIP_RETURN_CODE
+    moc = qt5_moc()
+    if moc is None:
+        print("probe: skipped (no Qt 5 moc found)")
+        return SKIP_RETURN_CODE
+    with tempfile.TemporaryDirectory(prefix="qt5-qjson-") as workdir:
+        usable, verdict = fixture_verdict(cxx, flags, workdir, os.path.join(root, "include"))
+        if not usable:
+            print(f"FAIL: compatibility fixture unusable ({verdict})")
+            return 1
+        print(verdict)
+        failure = probe_translation_unit(cxx, flags, root, build, moc, workdir)
+    if not failure:
+        print(f"PASS: {TEST_SOURCE} compiles against Qt 5 and reads JSON integers through jsonInteger")
+        return 0
+    print(failure)
+    print("FAIL: ScriptClockTest reads JSON numbers through QJsonValue::toInteger, which Qt 5.15 "
+          "does not have; use jsonInteger from DeprecationHelper.h")
+    return 1
+
+
+def main(argv):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--root", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+    parser.add_argument("--build-dir")
+    parser.add_argument("--cxx", default=os.environ.get("CXX") or shutil.which("c++") or "c++")
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args(argv[1:])
+
+    root = os.path.abspath(args.root)
+    if not os.path.isdir(root):
+        print(f"error: not a directory: {root}", file=sys.stderr)
+        return 2
+    if args.self_test:
+        return run_self_test(args.cxx, root)
+    return check_product(args.cxx, root, os.path.abspath(args.build_dir or os.path.join(root, "build")))
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main(sys.argv))
+    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
+        print(f"Qt 5 QJsonValue integer check: {error}", file=sys.stderr)
+        sys.exit(1)
diff --git a/tests/VideoClipsNoFfmpegCheck.py b/tests/VideoClipsNoFfmpegCheck.py
new file mode 100644
index 0000000000..9a989a41b2
--- /dev/null
+++ b/tests/VideoClipsNoFfmpegCheck.py
@@ -0,0 +1,315 @@
+#!/usr/bin/env python3
+"""The multi-clip video tests must compile when the build has no FFmpeg.
+
+Cluster ci-78cca41150908714, hosted ``build / macos-x86_64``: the video test
+sources are registered for every build, but VideoTestClip.h defines
+``videotest::makeClip`` only inside its ``#ifdef ZENE_HAVE_FFMPEG`` block. The
+tests called the helper unguarded, so the job without FFmpeg stopped the build:
+
+    tests/src/core/VideoClipsTest.cpp:530:19: error: no member named 'makeClip'
+        in namespace 'videotest'
+
+VideoClipsTest and its GUI sibling VideoClipsGuiTest share that needClips() call
+and both must compile in the same configuration. This check compiles each real
+translation unit through its own line in build/compile_commands.json, first as
+configured and then against a shadow lmmsconfig.h with ZENE_HAVE_FFMPEG removed
+- the hosted shape. The shadow is proved in both directions with fixtures before
+the translation units are compiled. Exit codes: 0 = every compile passes, 1 =
+the test-source defect, 2 = the check cannot run.
+"""
+
+import argparse
+import json
+import os
+import re
+import shlex
+import subprocess
+import sys
+import tempfile
+
+SOURCES = (
+    os.path.join("tests", "src", "core", "VideoClipsTest.cpp"),
+    os.path.join("tests", "src", "gui", "VideoClipsGuiTest.cpp"),
+)
+CONFIG = "lmmsconfig.h"
+MARKER = "ZENE_HAVE_FFMPEG"
+
+WINDOWS_COMMAND_RE = re.compile(r"(?:^|[\s=\"'])[A-Za-z]:[\\/]|\\\\[^\"']")
+
+
+def fail(message):
+    print("VideoClipsNoFfmpegCheck: " + message, file=sys.stderr)
+    return 2
+
+
+def split_command(entry):
+    """The recorded compile line as an argument list (response files stay literal)."""
+    if entry.get("command"):
+        command = entry["command"]
+        if WINDOWS_COMMAND_RE.search(command):
+            escaped_quote = "\uE000"
+            command = command.replace('\\"', escaped_quote)
+            lexer = shlex.shlex(command, posix=True)
+            lexer.whitespace_split = True
+            lexer.commenters = ""
+            lexer.escape = ""
+            return [arg.replace(escaped_quote, '"') for arg in lexer]
+        return shlex.split(command)
+    return list(entry.get("arguments") or [])
+
+
+def compile_flags(entry):
+    """The recorded command without its output/depfile arguments or compile action."""
+    args = split_command(entry)
+    out, index = [], 0
+    while index < len(args):
+        arg = args[index]
+        if arg in ("-o", "-MF", "-MT", "/Fo"):
+            index += 2
+            continue
+        if arg.startswith("/Fo") or arg in ("-MD", "-MMD", "-MP", "-c", "/c"):
+            index += 1
+            continue
+        out.append(arg)
+        index += 1
+    return out
+
+
+def is_msvc(compiler):
+    """True for the MSVC driver family: cl.exe and clang-cl."""
+    return os.path.basename(compiler.replace("\\", "/")).lower() in (
+        "cl", "cl.exe", "clang-cl", "clang-cl.exe")
+
+
+def switch(compiler, msvc, other):
+    """MSVC's spelling of a switch on cl/clang-cl, the gcc/clang one elsewhere."""
+    return msvc if is_msvc(compiler) else other
+
+
+def include_dirs(args):
+    out, index = [], 0
+    while index < len(args):
+        arg = args[index]
+        if arg in ("-I", "-isystem", "/I", "/external:I") and index + 1 < len(args):
+            out.append(args[index + 1])
+            index += 2
+            continue
+        if arg.startswith(("-I", "/I", "/external:I")):
+            value = arg[len("/external:I"):] if arg.lower().startswith("/external:i") else arg[2:]
+            if value:
+                out.append(value)
+        elif arg.startswith("-isystem") and len(arg) > len("-isystem"):
+            out.append(arg[len("-isystem"):])
+        index += 1
+    return out
+
+
+def run(command, directory, timeout=600):
+    return subprocess.run(command, cwd=directory, capture_output=True, text=True, timeout=timeout)
+
+
+def errors_of(result):
+    output = (result.stderr or "") + "\n" + (result.stdout or "")
+    return [line.strip() for line in output.splitlines() if "error" in line.lower()]
+
+
+def tu_command(entry, includes):
+    """The recorded compile line, made syntax-only and preceded by @includes."""
+    args = compile_flags(entry)
+    return ([args[0], switch(args[0], "/Zs", "-fsyntax-only")]
+            + [switch(args[0], "/I", "-I") + path for path in includes] + args[1:])
+
+
+def fixture_command(compiler, includes, source):
+    return ([compiler, switch(compiler, "/Zs", "-fsyntax-only")]
+            + [switch(compiler, "/I", "-I") + path for path in includes] + [source])
+
+
+def source_path(root, entry):
+    path = entry["file"]
+    return os.path.normpath(path if os.path.isabs(path) else os.path.join(entry["directory"], path))
+
+
+def find_entry(entries, root, relative):
+    wanted = os.path.normpath(os.path.join(root, relative))
+    for entry in entries:
+        if os.path.normcase(source_path(root, entry)) == os.path.normcase(wanted):
+            return entry
+    return None
+
+
+def find_config(entry):
+    """The lmmsconfig.h the recorded command actually sees."""
+    for include in include_dirs(compile_flags(entry)):
+        directory = include if os.path.isabs(include) else os.path.join(entry["directory"], include)
+        candidate = os.path.normpath(os.path.join(directory, CONFIG))
+        if os.path.isfile(candidate):
+            return candidate
+    return None
+
+
+def moc_include(entry, source, tempdir, moc):
+    """Generate the .moc the test TU includes itself; (directory or None, detail)."""
+    match = re.search(r'#include\s+"([\w.+-]+\.moc)"',
+                      open(source, encoding="utf-8", errors="replace").read())
+    if match is None:
+        return None, ""
+    if not moc or not os.path.isfile(moc):
+        return None, "includes %s but no usable moc was given" % match.group(1)
+    output = os.path.join(tempdir, match.group(1))
+    command = [moc, source, "-o", output]
+    for directory in include_dirs(compile_flags(entry)):
+        command += ["-I", directory]
+    produced = run(command, entry["directory"])
+    if produced.returncode != 0:
+        detail = (produced.stderr or produced.stdout).strip().splitlines()
+        return None, "moc failed: " + (detail[-1] if detail else "no output")
+    return tempdir, ""
+
+
+def write_shadow(real, shadow):
+    """Copy lmmsconfig.h without its ZENE_HAVE_FFMPEG define; return the define count."""
+    text = open(real, encoding="utf-8", errors="replace").read()
+    text, removed = re.subn(r"^[ \t]*#[ \t]*define[ \t]+" + MARKER + r"\b.*$",
+                            "/* shadow: " + MARKER + " removed for the no-FFmpeg check */",
+                            text, flags=re.M)
+    if removed:
+        with open(os.path.join(shadow, CONFIG), "w", encoding="utf-8") as handle:
+            handle.write(text)
+    return removed
+
+
+def prove_shadow(entry, shadow, tempdir):
+    """Fixtures prove the shadow removes the define and the configured header keeps it."""
+    compiler = compile_flags(entry)[0]
+    recorded = include_dirs(compile_flags(entry))
+    base = os.path.join(tempdir, "fixture-configured.cpp")
+    strict = os.path.join(tempdir, "fixture-shadowed.cpp")
+    with open(base, "w", encoding="utf-8") as handle:
+        handle.write('#include "%s"\n#ifndef %s\n#error configured header lost %s\n#endif\n'
+                     % (CONFIG, MARKER, MARKER))
+    with open(strict, "w", encoding="utf-8") as handle:
+        handle.write('#include "%s"\n#ifdef %s\n#error shadow header kept %s\n#endif\n'
+                     % (CONFIG, MARKER, MARKER))
+    configured = run(fixture_command(compiler, recorded, base), entry["directory"])
+    shadowed = run(fixture_command(compiler, [shadow] + recorded, strict), entry["directory"])
+    print("shadow removes %s: %s" % (MARKER, "yes" if shadowed.returncode == 0 else "NO"))
+    print("configured header defines %s: %s" % (MARKER, "yes" if configured.returncode == 0 else "NO"))
+    if shadowed.returncode or configured.returncode:
+        for result in (configured, shadowed):
+            for line in errors_of(result):
+                print("  " + line)
+        return False
+    return True
+
+
+def compile_tu(entry, includes, label):
+    result = run(tu_command(entry, includes), entry["directory"])
+    print("%s: %s (exit %d)" % (label, "PASS" if result.returncode == 0 else "FAIL", result.returncode))
+    if result.returncode:
+        for line in errors_of(result):
+            print("  " + line)
+    return result.returncode == 0
+
+
+def prepare_tu(entry, source, tempdir, moc):
+    """The generated .moc include directory for a test TU; (includes, error)."""
+    moc_dir, detail = moc_include(entry, source, tempdir, moc)
+    if moc_dir is None and detail:
+        return None, detail
+    return ([moc_dir] if moc_dir else []), ""
+
+
+def load_entries(build):
+    """The build's compile_commands.json; (entries, error)."""
+    commands = os.path.join(build, "compile_commands.json")
+    if not os.path.isfile(commands):
+        return None, "no compile_commands.json in " + build
+    entries = json.load(open(commands))
+    if not isinstance(entries, list) or not entries:
+        return None, "invalid or empty compile_commands.json in " + build
+    return entries, ""
+
+
+def collect_sources(entries, root):
+    """(relative, entry, source) for every TU the check compiles; (found, error)."""
+    found = []
+    for relative in SOURCES:
+        entry = find_entry(entries, root, relative)
+        if entry is None:
+            return None, "no compile_commands.json entry for " + os.path.join(root, relative)
+        source = os.path.join(root, relative)
+        if not os.path.isfile(source):
+            return None, "missing source " + source
+        found.append((relative, entry, source))
+    return found, ""
+
+
+def prepare_all(found, tempdir, moc):
+    """Compile each TU as configured; (prepared, error)."""
+    prepared = []
+    for relative, entry, source in found:
+        includes, detail = prepare_tu(entry, source, tempdir, moc)
+        if includes is None:
+            return None, detail
+        if not compile_tu(entry, includes, relative + " configured"):
+            return None, relative + " does not compile as configured"
+        prepared.append((relative, entry, includes))
+    return prepared, ""
+
+
+def shadow_compiles(prepared, shadow):
+    """Compile each prepared TU without the macro; the failing relatives."""
+    failed = []
+    for relative, entry, includes in prepared:
+        if not compile_tu(entry, [shadow] + includes, relative + " without " + MARKER):
+            failed.append(relative)
+    return failed
+
+
+def check(root, build, moc):
+    entries, error = load_entries(build)
+    if entries is None:
+        return fail(error)
+    found, error = collect_sources(entries, root)
+    if found is None:
+        return fail(error)
+    with tempfile.TemporaryDirectory(prefix="videoclips-noffmpeg-") as tempdir:
+        prepared, error = prepare_all(found, tempdir, moc)
+        if prepared is None:
+            return fail(error)
+        real = find_config(found[0][1])
+        if real is None:
+            return fail("could not find " + CONFIG + " on the recorded include path")
+        shadow = os.path.join(tempdir, "shadow")
+        os.makedirs(shadow)
+        if not write_shadow(real, shadow):
+            print("this build's %s already lacks %s; the configured compiles are the no-FFmpeg proof"
+                  % (CONFIG, MARKER))
+            return 0
+        if not prove_shadow(found[0][1], shadow, tempdir):
+            return fail("the shadow header does not take effect")
+        failed = shadow_compiles(prepared, shadow)
+        if failed:
+            print("FAIL: %s do not compile without %s" % (", ".join(failed), MARKER))
+            return 1
+        print("PASS: every video clip test compiles in a build without " + MARKER)
+    return 0
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", required=True)
+    parser.add_argument("--build-dir", required=True)
+    parser.add_argument("--moc", default="")
+    args = parser.parse_args()
+    root = os.path.abspath(args.source_root)
+    build = os.path.abspath(args.build_dir)
+    return check(root, build, args.moc)
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, subprocess.SubprocessError) as error:
+        sys.exit(fail(str(error)))

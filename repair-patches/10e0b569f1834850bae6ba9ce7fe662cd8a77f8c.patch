+#!/usr/bin/env python3
+"""Qt 5/6 compiler regression for MixerSendsOnFadersTest's expected-fader-list assertion."""
+
+# Copyright (c) 2026 Zene Studio contributors
+#
+# This file is part of LMMS - https://lmms.io
+#
+# This program is free software; you can redistribute it and/or modify it under
+# the terms of the GNU General Public License as published by the Free
+# Software Foundation; either version 2 of the License, or (at your option)
+# any later version.
+
+import argparse
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+def fail(message):
+    raise RuntimeError(message)
+
+
+def invoke(command, cwd=None):
+    return subprocess.run(command, cwd=cwd, text=True, stdout=subprocess.PIPE,
+                          stderr=subprocess.PIPE, check=False)
+
+
+def pkg_flags(pkg, modules):
+    tool = shutil.which(pkg)
+    if tool is None:
+        fail(f"required tool is missing: {pkg}")
+    result = invoke([tool, "--cflags", *modules])
+    if result.returncode:
+        fail(f"{pkg} {' '.join(modules)} failed: {result.stderr.strip()}")
+    return shlex.split(result.stdout)
+
+
+def pkg_exists(pkg, modules):
+    tool = shutil.which(pkg)
+    return tool is not None and invoke([tool, "--exists", *modules]).returncode == 0
+
+
+def compile_source(compiler, source, directory, label, *, success, flags=()):
+    path = directory / f"{label}.cpp"
+    path.write_text(source, encoding="utf-8")
+    result = invoke([compiler, "-std=c++20", "-Wall", "-Werror", *flags,
+                     "-c", str(path), "-o", str(directory / f"{label}.o")])
+    if (result.returncode == 0) != success:
+        fail(f"{label}: expected {'compile success' if success else 'compile failure'}; "
+             f"exit {result.returncode}: {result.stderr.strip()}")
+    print(f"PASS {label}: {'compiled' if success else 'failed as expected'}")
+
+
+def fader_assertion(root):
+    source = (root / "tests/src/gui/MixerSendsOnFadersTest.cpp").read_text(encoding="utf-8")
+    match = re.search(r"^\t\tQVERIFY\(faders == .*QStringLiteral\(\"volume\"\).*\);\s*$",
+                      source, re.M)
+    if match is None:
+        fail("MixerSendsOnFadersTest no longer has the expected-fader-list assertion")
+    assertion = match.group(0).strip()
+    if "channels" not in assertion:
+        fail("the expected fader list no longer depends on the mixer channel count")
+    if "QVector<" in assertion and "#include <QVector>" not in source:
+        fail("the expected fader list uses QVector without including <QVector>")
+    return assertion
+
+
+def fixture(assertion):
+    # The assertion is the test's own source line: faders and channels are the only names it needs.
+    return """#include <QtTest>
+#include <QStringList>
+#include <QVector>
+
+void probe()
+{
+	const int channels = 3;
+	QStringList faders;
+	for (int i = 0; i < channels; ++i) { faders.append(QStringLiteral("volume")); }
+	%s
+}
+""" % assertion
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", required=True, type=Path)
+    args = parser.parse_args()
+    root = args.source_root.resolve()
+    compiler = shutil.which("c++")
+    if compiler is None:
+        fail("required tool is missing: c++")
+    assertion = fader_assertion(root)
+    source = fixture(assertion)
+    with tempfile.TemporaryDirectory(prefix="mixer-sends-portability-") as directory:
+        temporary = Path(directory)
+        qt5 = pkg_flags("pkg-config", ["Qt5Test", "Qt5Core"])
+        compile_source(compiler, source, temporary, "faders-qt5-assertion", success=True,
+                       flags=[*qt5, "-fPIC"])
+        if pkg_exists("pkg-config", ["Qt6Test", "Qt6Core"]):
+            qt6 = pkg_flags("pkg-config", ["Qt6Test", "Qt6Core"])
+            compile_source(compiler, source, temporary, "faders-qt6-assertion", success=True,
+                           flags=[*qt6, "-fPIC"])
+        else:
+            print("OMITTED faders-qt6-assertion: Qt6Test/Qt6Core unavailable")
+        original = source.replace(
+            assertion, 'QVERIFY(faders == QStringList(channels, QStringLiteral("volume")));')
+        compile_source(compiler, original, temporary, "faders-qt5-original", success=False,
+                       flags=[*qt5, "-fPIC"])
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, RuntimeError, ValueError) as error:
+        print(f"mixer sends portability check: {error}", file=sys.stderr)
+        sys.exit(1)

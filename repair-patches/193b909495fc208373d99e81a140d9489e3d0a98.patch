--- /dev/null
+++ b/tests/src/core/PortableSync.h
@@ -0,0 +1,157 @@
+/*
+ * PortableSync.h - test synchronisation that compiles below macOS 11
+ *
+ * Copyright (c) 2026 Zene Studio contributors
+ *

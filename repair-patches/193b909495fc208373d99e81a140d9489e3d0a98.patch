+        usable, verdict = fixture_verdict(cxx, flags, workdir)
+        if not usable:
+            print(f"probe: skipped ({verdict})")
+            return 0
+        print(verdict)
+        failure = probe_translation_unit(cxx, flags, root, build, moc, workdir)
+    if not failure:
+        print(f"PASS: {TEST_SOURCE} compiles against Qt 5, and no QStringList takes a braced-init-list")

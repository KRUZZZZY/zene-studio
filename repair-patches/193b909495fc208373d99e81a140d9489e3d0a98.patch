+#!/usr/bin/env python3
+"""Fail when a QStringList is assigned a braced-init-list, which Qt 5.15 rejects.
+
+Cluster ci-623e9e3a015cd5b1 (2026-11-14), hosted `build / linux-x86_64` job at
+c20ef591b571e3c3dc7b108107d166497f1b34be: the job builds against Qt 5.15, where
+`QStringList` declares four `operator=` candidates (its own copy/move ones plus the
+inherited `QList<QString>` copy/move ones). A braced-init-list converts equally well to
+`QList<QString>` and `QStringList`, so
+
+    tests/src/core/ImportTrackIoTest.cpp:344:
+        plan.documents = {UnparsableTrack, trackDocument(Lead)};
+
+stopped the whole build:
+
+    error: ambiguous overload for 'operator=' (operand types are 'QStringList' and
+    '<brace-enclosed initializer list>')
+
+Qt 6 declares no assignment operators of its own on QStringList, so every Qt 6 host here
+compiles the same line; only the hosted Qt 5 build sees the defect. The portable spelling
+is an explicit temporary - `plan.documents = QStringList{UnparsableTrack, trackDocument(Lead)};`
+- which selects the QStringList move-assignment on both.
+
+The check has two deterministic halves:
+
+  * fixtures: a BAD `QStringList s; s = {a, b};` must be rejected by a Qt 5 tree, and a
+    GOOD `s = QStringList{a, b};` accepted. A tree that accepts BAD is not a Qt 5 tree
+    with the trap, so the probe reports itself skipped rather than passed.
+  * the real translation unit: tests/src/core/ImportTrackIoTest.cpp is recompiled
+    `-fsyntax-only` through this build's compile_commands.json against the Qt 5 headers
+    (and the Qt 5 moc), retargeting the recorded Qt 6 include directories. That is the
+    hosted job's compiler input, so a regression here is the hosted failure.
+
+The probe reports itself skipped (never passed) when pkg-config finds no Qt 5 development
+tree; the hosted linux-x86_64 job is Qt 5, so it is red there before the fix.
+
+Usage:
+  Qt5QStringListAssignmentCheck.py [--root DIR] [--build-dir DIR] [--cxx CXX]
+  Qt5QStringListAssignmentCheck.py --self-test
+
+Exit codes: 0 = clean (or skipped on a host without Qt 5), 1 = finding or failed fixture,
+2 = usage error.
+"""
+
+import argparse
+import json
+import os
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TEST_SOURCE = "tests/src/core/ImportTrackIoTest.cpp"
+
+# Qt 6 modules whose include directories must give way to the Qt 5 tree.
+QT_MODULES = {"qtcore", "qtgui", "qtwidgets", "qtxml", "qtnetwork", "qttest", "qtsvg", "qtdbus", "qtconcurrent"}
+
+BAD_FIXTURE = """\
+#include <QString>
+#include <QStringList>
+
+int main()
+{
+    QStringList documents;
+    documents = {QStringLiteral("a"), QStringLiteral("b")};
+    return documents.size() == 2 ? 0 : 1;
+}
+"""
+
+GOOD_FIXTURE = """\
+#include <QString>
+#include <QStringList>
+
+int main()
+{
+    QStringList documents;
+    documents = QStringList{QStringLiteral("a"), QStringLiteral("b")};
+    return documents.size() == 2 ? 0 : 1;
+}
+"""
+
+
+def run(command, cwd=None, timeout=600):
+    try:
+        return subprocess.run(command, cwd=cwd, capture_output=True, text=True, timeout=timeout)
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+
+def qt5_flags():
+    """Compile flags of a Qt 5 development tree, or None when pkg-config has none."""
+    if not shutil.which("pkg-config"):
+        return None
+    if run(["pkg-config", "--exists", "Qt5Widgets"]).returncode != 0:
+        return None
+    for packages in (["Qt5Widgets", "Qt5Xml", "Qt5Network", "Qt5Test"],
+                     ["Qt5Widgets", "Qt5Xml", "Qt5Network"],
+                     ["Qt5Widgets"]):
+        result = run(["pkg-config", "--cflags", *packages])
+        if result is not None and result.returncode == 0:
+            return shlex.split(result.stdout)
+    return None
+
+
+def qt5_moc():
+    """The Qt 5 moc, or None. A Qt 6 moc cannot pre-process a Qt 5 translation unit."""
+    result = run(["pkg-config", "--variable=host_bins", "Qt5Core"])
+    if result is not None and result.returncode == 0 and result.stdout.strip():
+        candidate = os.path.join(result.stdout.strip(), "moc")
+        if os.path.isfile(candidate):
+            version = run([candidate, "-v"])
+            if version is not None and version.stdout.strip().startswith("moc 5"):
+                return candidate
+    return None
+
+
+def compile_fixture(cxx, flags, workdir, name, text):
+    path = os.path.join(workdir, name)
+    with open(path, "w", encoding="utf-8") as handle:
+        handle.write(text)
+    return run([cxx, "-std=gnu++20", "-fPIC", "-fsyntax-only", *flags, path])
+
+
+def fixture_verdict(cxx, flags, workdir):
+    """(usable, verdict) for the tree: usable only when it rejects BAD and accepts GOOD."""
+    bad = compile_fixture(cxx, flags, workdir, "bad.cpp", BAD_FIXTURE)
+    good = compile_fixture(cxx, flags, workdir, "good.cpp", GOOD_FIXTURE)
+    if bad is None or bad.returncode == 0:
+        return False, "no fixture"
+    if good is None or good.returncode != 0:
+        return False, "the Qt 5 tree rejects the explicit QStringList constructor"
+    return True, "probe: Qt 5 rejects the braced QStringList assignment and accepts the explicit one"
+
+
+def compile_database(build):
+    path = os.path.join(build, "compile_commands.json")
+    if not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8", errors="replace") as handle:
+        entries = json.load(handle)
+    return entries if isinstance(entries, list) else None
+
+
+def entry_for(entries, root, relative):
+    wanted = os.path.realpath(os.path.join(root, relative))
+    for entry in entries:
+        if os.path.realpath(entry.get("file", "")) == wanted:
+            return entry
+    return None
+
+
+def is_qt6_include(directory):
+    parts = [part for part in re.split(r"[\\/]+", directory.rstrip("\\/")) if part]
+    return "qt6" in parts or bool(parts and parts[-1].lower() in QT_MODULES and any("qt6" in part for part in parts))
+
+
+def qt5_command(entry, flags, extra):
+    """The recorded compile line retargeted at the Qt 5 headers, without -Werror."""
+    arguments = entry.get("arguments")
+    if arguments is None:
+        arguments = shlex.split(entry.get("command", ""))
+    out = []
+    index = 0
+    while index < len(arguments):
+        argument = arguments[index]
+        if argument in ("-o", "-c", "-MD", "-MMD", "-MP"):
+            index += 2 if argument in ("-o", "-c") else 1
+            continue
+        if argument in ("-isystem", "-I") and index + 1 < len(arguments):
+            if not is_qt6_include(arguments[index + 1]):
+                out += [argument, arguments[index + 1]]
+            index += 2
+            continue
+        if argument == "-Werror":
+            index += 1
+            continue
+        out.append(argument)
+        index += 1
+    # The Qt 5 moc output must win over the recorded Qt 6 autogen directory, so the extra
+    # include directories go first.
+    return out[:1] + list(extra) + out[1:] + list(flags) + ["-fsyntax-only"]
+
+
+def probe_translation_unit(cxx, flags, root, build, moc, workdir):
+    entries = compile_database(build)
+    if entries is None:
+        return f"no compile database at {os.path.join(build, 'compile_commands.json')}"
+    entry = entry_for(entries, root, TEST_SOURCE)
+    if entry is None:
+        return f"{TEST_SOURCE}: no entry in the compile database"
+    source = os.path.realpath(os.path.join(root, TEST_SOURCE))
+    generated = os.path.join(workdir, "ImportTrackIoTest.moc")
+    made = run([moc, source, "-o", generated])
+    if made is None or made.returncode != 0:
+        return f"{TEST_SOURCE}: the Qt 5 moc failed"
+    command = qt5_command(entry, flags, ["-I" + workdir])
+    command.append(source)
+    result = run(command, cwd=entry.get("directory") or root)
+    if result is None:
+        return f"{TEST_SOURCE}: the Qt 5 compile probe could not run"
+    if result.returncode != 0:
+        diagnostic = "\n".join(line for line in (result.stdout + result.stderr).splitlines()
+                               if re.search(r"error:|note:", line))[:3000]
+        return f"{TEST_SOURCE}: Qt 5 rejected it\n{diagnostic}"
+    return None
+
+
+def self_test(cxx, flags):
+    """The fixtures must be distinguishable before the real translation unit is trusted."""
+    with tempfile.TemporaryDirectory(prefix="qt5-qstringlist-fixtures-") as workdir:
+        return fixture_verdict(cxx, flags, workdir)
+
+
+def run_self_test(cxx):
+    """The fixtures still need a Qt 5 tree; they prove the instrument, never the product."""
+    flags = qt5_flags()
+    if flags is None:
+        print("self-test: skipped (no Qt 5 development tree found)")

tests/src/core/AudioBusTest.cpp: unit-only lines=22 present-at-HEAD(verbatim/renamed)=1 substring-of-a-HEAD-line=0 RESIDUE=21
   RESIDUE|  * AudioBusTest.cpp - unit tests for AudioBus (Phase F hardening, task #592)
   RESIDUE|  * Copyright (c) 2026 LMMS developers
   RESIDUE| #include "LmmsTypes.h"
   RESIDUE| 	//! Regression test for the pair-iteration bug in silenceAllChannels():
   RESIDUE| 	//! m_channelPairs is the number of channel *pairs*, so the loop must
   RESIDUE| 	//! advance one pair at a time. Stepping by 2 (as track channels) only
   RESIDUE| 	//! zeroed every second pair and left the rest of the bus carrying signal.
   RESIDUE| 	//! Multi-pair buses are what multi-channel plugin I/O uses, so a bus that
   RESIDUE| 	//! silently keeps signal is exactly the fixed-count artefact SPEC 8.2
   RESIDUE| 	//! asks us to rule out.
   RESIDUE| 				// distinct non-zero value per pair so a missed pair is named
   RESIDUE| 		// The single-pair bus used by every MixerChannel/AudioBusHandle must
   RESIDUE| 		// keep working (this is the shape the mixer actually creates).
   RESIDUE| 		SampleFrame single[1][frames];
   RESIDUE| 		SampleFrame* singleBus[1] = {single[0]};
   RESIDUE| 			single[0][f][0] = 0.5f;
   RESIDUE| 			single[0][f][1] = 0.5f;
   RESIDUE| 		AudioBus singlePair{singleBus, 1, frames};
   RESIDUE| 		singlePair.silenceAllChannels();
   RESIDUE| 			QCOMPARE(single[0][f][0], 0.0f);
   RESIDUE| 			QCOMPARE(single[0][f][1], 0.0f);


+		QVERIFY( model.slot( 1, 1 ).isEmpty() );
+		QVERIFY( model.scene( 1 ).name().isEmpty() );
+		QCOMPARE( model.slot( 1, 0 ).patternId(), -1 );
+	}
+};
+
+QTEST_GUILESS_MAIN( SessionModelTest )

--- /dev/null
+++ b/src/core/SessionClip.cpp
@@ -0,0 +1,210 @@
+/*
+ * SessionClip.cpp - ClipSlot and Scene serialisation (Session View)
+ *
+ * Copyright (c) 2026 Zene Studio contributors
+ *
+ * This file is part of LMMS - https://lmms.io
+ *

      RESIDUE| 		// never a child element - Track::loadTrack turns an unrecognised child
      RESIDUE| 		// element into a real Clip, so an id element would make every track
      RESIDUE| 		// grow a phantom clip on load, on every track, in every project.
      RESIDUE| 		element.setAttribute( "id", m_id );
      RESIDUE| 	// The stable id (SPEC-stable-ids.md rules R1/R2). A file that carries one
      RESIDUE| 	// keeps it; a legacy file that does not gets the number the constructor
      RESIDUE| 	// already handed out, which is deterministic because Song::loadProject walks
      RESIDUE| 	// the containers in document order. Either way ProjectIds::loadAssignments()
      RESIDUE| 	// counts it, and project.open reports the count as `ids_assigned`, so a
      RESIDUE| 	// legacy file's one-time upgrade is stated rather than silent.
      RESIDUE| 	if (element.hasAttribute("id"))
      RESIDUE| 		bool ok = false;
      RESIDUE| 		const int stored = element.attribute("id").toInt(&ok);
      RESIDUE| 		if (ok && stored >= 0) { setId(stored); }

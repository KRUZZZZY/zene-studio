      RESIDUE| 			"(see the log for the parser's line/column report)" );
      RESIDUE| 			m_loadRefusal = tr("Project file contains local paths to plugins, which could be used to "
      RESIDUE| 					"run malicious code.");
      RESIDUE| 			// In an agent instance nobody can answer this box (task #625), so
      RESIDUE| 			// the refusal becomes the typed error project.open returns.
      RESIDUE| 			if (getGUI() != nullptr && !lmms::isUnattendedRun())
      RESIDUE| 					m_loadRefusal);
      RESIDUE| 	// The id pass, load half (SPEC-stable-ids.md R2/R3). Reset the counter so
      RESIDUE| 	// assignment is deterministic - the container walk below creates the tracks
      RESIDUE| 	// in document order and the Track constructor allocates in that order, so
      RESIDUE| 	// the same legacy document always yields the same ids - and clear the
      RESIDUE| 	// assignment count project.open reports as `ids_assigned`.
      RESIDUE| 	ProjectIds::reset();
      RESIDUE| 	ProjectIds::beginLoad();
      RESIDUE| 	// The id pass, post-walk half (SPEC-stable-ids.md R3). The objects exist and
      RESIDUE| 	// carry ids now, so this is the one place the document's own counter can be
      RESIDUE| 	// honoured and repaired:
      RESIDUE| 	//  * `next-id` is taken from the root. A file written by this build carries
      RESIDUE| 	//    it; a legacy file (or a file that came back through an older build,
      RESIDUE| 	//    which drops it) does not, and then the counter is already at
      RESIDUE| 	//    max(id seen)+1 because every setId() observed its value.
      RESIDUE| 	//  * Two live tracks sharing an id is only reachable from an external merge
      RESIDUE| 	//    of two projects (GIT-FRIENDLY-MMPZ.md documents real .mmpz merges). The
      RESIDUE| 	//    second in document order is re-assigned from the high-water mark and
      RESIDUE| 	//    counted, so the repair shows up in `ids_assigned` instead of hiding.
      RESIDUE| 	if (dataFile.documentElement().hasAttribute(QStringLiteral("next-id")))
      RESIDUE| 		bool ok = false;

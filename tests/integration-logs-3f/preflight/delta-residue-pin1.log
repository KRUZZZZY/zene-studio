      RESIDUE| 	# symbols from the host process at load time, exactly like the zene
      RESIDUE| 	# executable) get ENABLE_EXPORTS and the plugin directory. ScriptEngineTest
      RESIDUE| 	# does it for the Lua Instrument binding; ControlDeviceCatalogueTest does it
      RESIDUE| 	# so PluginFactory discovers lv2effect/lv2instrument and the LV2 half of the
      RESIDUE| 	# device catalogue is real rather than empty.  PluginScanCacheTest drives the
      RESIDUE| 	# scan cache against a copy of the built tripleoscillator module;
      RESIDUE| 	# ReversibilityContractTest/ReversibilityUndoTest load the real binary's
      RESIDUE| 	# plugins to prove the A16 inverses (#623).
      RESIDUE| 		OR LMMS_TEST_NAME STREQUAL "ControlDeviceCatalogueTest"
      RESIDUE| 		OR LMMS_TEST_NAME STREQUAL "ReversibilityContractTest"
      RESIDUE| 		OR LMMS_TEST_NAME STREQUAL "ReversibilityUndoTest")
      RESIDUE| # Agent control surface (SPEC A12/A16). The ControlRegistryTest unit test runs
      RESIDUE| # in the LMMS_TESTS loop above; this one starts the real binary with
      RESIDUE| # --control-socket under QT_QPA_PLATFORM=offscreen and drives it from an
      RESIDUE| # EXTERNAL Python client over the AF_UNIX socket, so the socket, the wire
      RESIDUE| # framing and the command groups are exercised end to end.
      RESIDUE| find_program(PYTHON3_EXECUTABLE NAMES python3)
      RESIDUE| if(PYTHON3_EXECUTABLE)
      RESIDUE| 	add_test(NAME ControlSocketIntegration
      RESIDUE| 		COMMAND ${PYTHON3_EXECUTABLE}
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/control-socket-integration.py
      RESIDUE| 			$<TARGET_FILE:zene>
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/data/agent-control-fixture.mmp
      RESIDUE| 	set_tests_properties(ControlSocketIntegration PROPERTIES
      RESIDUE| 		TIMEOUT 600
      RESIDUE| else()
      RESIDUE| 	message(STATUS "python3 not found: ControlSocketIntegration is not registered")
      RESIDUE| # Task #626: the shutdown and readiness defects of the control surface.
      RESIDUE| # ControlShutdown         - a clean shutdown for BOTH reproductions (undo/redo
      RESIDUE| #                           leaves the project modified -> the quit prompt used to
      RESIDUE| #                           block; an audio device that cannot open -> the startup
      RESIDUE| #                           audio dialog used to block before app->exec()).
      RESIDUE| # ControlReadiness        - connects BEFORE readiness and asserts the documented
      RESIDUE| #                           order: connect -> poll control.ping -> wait for
      RESIDUE| #                           engine_ready -> issue engine commands.
      RESIDUE| # ControlNoAudioDevice    - a started instance with no usable audio device reports
      RESIDUE| #                           the reason instead of answering `busy` forever.
      RESIDUE| # ControlNegativeControl  - proves each of those can fail: the pre-fix artefacts
      RESIDUE| #                           and real SIGKILL/SIGSTOP symptoms must be detected, so
      RESIDUE| #                           none of the checks above is a tautology.
      RESIDUE| # All four are bounded by ctest's TIMEOUT and by deadlines inside each script: a
      RESIDUE| # hang counts as a failure, never as a wait.
      RESIDUE| if(PYTHON3_EXECUTABLE)
      RESIDUE| 	add_test(NAME ControlShutdown
      RESIDUE| 		COMMAND ${PYTHON3_EXECUTABLE}
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/control-shutdown.py
      RESIDUE| 			$<TARGET_FILE:zene>
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/data/agent-control-fixture.mmp
      RESIDUE| 	add_test(NAME ControlReadiness
      RESIDUE| 		COMMAND ${PYTHON3_EXECUTABLE}
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/control-readiness.py
      RESIDUE| 			$<TARGET_FILE:zene>
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/data/agent-control-fixture.mmp
      RESIDUE| 	add_test(NAME ControlNoAudioDevice
      RESIDUE| 		COMMAND ${PYTHON3_EXECUTABLE}
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/control-no-audio-device.py
      RESIDUE| 			$<TARGET_FILE:zene>
      RESIDUE| 	add_test(NAME ControlNegativeControl
      RESIDUE| 		COMMAND ${PYTHON3_EXECUTABLE}
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/control-negative-control.py
      RESIDUE| 			$<TARGET_FILE:zene>
      RESIDUE| 	set_tests_properties(ControlShutdown ControlReadiness ControlNoAudioDevice
      RESIDUE| 		ControlNegativeControl PROPERTIES
      RESIDUE| 		TIMEOUT 420
      RESIDUE| else()
      RESIDUE| 	message(STATUS "python3 not found: the #626 shutdown/readiness tests are not registered")
      RESIDUE| # agent_surface (SPEC A15 / task #620). The anti-drift gate: it reflects the
      RESIDUE| # LIVE menu/toolbar surface over the control socket, fails on any action that
      RESIDUE| # has no registered command (grandfathering the ones that do not, in
      RESIDUE| # tests/agent-surface-baseline.txt, under a shrink-only ratchet), checks that
      RESIDUE| # every declared command is either swept headless or allowlisted with a reason,
      RESIDUE| # and then sweeps each non-allowlisted command to a typed result under
      RESIDUE| # QT_QPA_PLATFORM=offscreen with a throwaway HOME.
      RESIDUE| # The gate is a Python file rather than a test binary on purpose: the reflection
      RESIDUE| # it needs lives in the running process (control.surface_report walks the real
      RESIDUE| # MainWindow), so the test drives a real instance exactly like an agent would.
      RESIDUE| # --check is passed explicitly: this gate must never rewrite its own baseline
      RESIDUE| # during a test run; only a deliberate --reanchor "reason" does that.
      RESIDUE| if(PYTHON3_EXECUTABLE)
      RESIDUE| 	add_test(NAME agent_surface
      RESIDUE| 		COMMAND ${PYTHON3_EXECUTABLE}
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/agent-surface-gate.py
      RESIDUE| 			$<TARGET_FILE:zene>
      RESIDUE| 			${CMAKE_CURRENT_SOURCE_DIR}/data/agent-control-fixture.mmp
      RESIDUE| 			--check
      RESIDUE| 			--report ${CMAKE_CURRENT_BINARY_DIR}/agent-surface-report.json
      RESIDUE| 	set_tests_properties(agent_surface PROPERTIES
      RESIDUE| 		TIMEOUT 300
      RESIDUE| else()
      RESIDUE| 	message(STATUS "python3 not found: agent_surface is not registered")
      RESIDUE| # The notes / clips / tracks command group edits real Song model objects
      RESIDUE| # (tracks, MidiClips, notes) rather than only reading them, so it needs a Qt
      RESIDUE| # platform plugin even though the assertions never open a window.
      RESIDUE| set_tests_properties(ControlEditCommandsTest PROPERTIES
      RESIDUE| # The stable-id tests construct a full Engine and drive project.open/save through
      RESIDUE| # the control registry, so they need a Qt platform plugin even though nothing
      RESIDUE| # opens a window.
      RESIDUE| set_tests_properties(StableTrackIdsTest PROPERTIES
      RESIDUE| # Headless load path (task #625, SPEC A13/A15): no modal dialog may block an
      RESIDUE| # instance started with --control-socket.
      RESIDUE| # Each test starts the real binary under QT_QPA_PLATFORM=offscreen, drives it
      RESIDUE| # from an external client, and treats a HANG as a failure: every wait is
      RESIDUE| # bounded. Each also has an `--expect-blocked` mode that asserts the pre-fix
      RESIDUE| # defect (the startup path parked inside a modal's nested event loop), so the
      RESIDUE| # tests cannot pass by accident. Reproductions against the base commit
      RESIDUE| # 6b01b98eb are recorded in the lane's evidence.
      RESIDUE| if(PYTHON3_EXECUTABLE)
      RESIDUE| 	foreach(HEADLESS_TEST
      RESIDUE| 			"ControlHeadlessProjectOpen|control-headless-project-open.py|${CMAKE_SOURCE_DIR}/data/projects/tutorials/editing_note_volumes.mmp ${CMAKE_CURRENT_SOURCE_DIR}/data/error-carrying-project.mmp"
      RESIDUE| 			"ControlHeadlessWorkingDirectory|control-headless-working-directory.py|"
      RESIDUE| 			"ControlHeadlessNoAudioDevice|control-headless-no-audio-device.py|")
      RESIDUE| 		string(REPLACE "|" ";" FIELDS "${HEADLESS_TEST}")
      RESIDUE| 		list(GET FIELDS 0 TEST_NAME)
      RESIDUE| 		list(GET FIELDS 1 TEST_SCRIPT)
      RESIDUE| 		list(GET FIELDS 2 TEST_ARGS)
      RESIDUE| 		separate_arguments(TEST_ARGS_LIST UNIX_COMMAND "${TEST_ARGS}")
      RESIDUE| 		add_test(NAME ${TEST_NAME}
      RESIDUE| 			COMMAND ${PYTHON3_EXECUTABLE}
      RESIDUE| 				${CMAKE_CURRENT_SOURCE_DIR}/${TEST_SCRIPT}
      RESIDUE| 				$<TARGET_FILE:zene>
      RESIDUE| 				${TEST_ARGS_LIST}
      RESIDUE| 		set_tests_properties(${TEST_NAME} PROPERTIES
      RESIDUE| 			TIMEOUT 300

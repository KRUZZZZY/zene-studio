      RESIDUE| 		"          AF_UNIX socket <path>. Opt-in; off unless given.\n"
      RESIDUE| 			scriptFile, controlSocket;
      RESIDUE| 		else if( arg == "--control-socket" )
      RESIDUE| 			// Opt-in agent control socket (SPEC-zene-studio.md A12). Off unless
      RESIDUE| 			// this flag is given; the socket is AF_UNIX, mode 0600, local only.
      RESIDUE| 				return usageError( "No control socket path specified" );
      RESIDUE| 			controlSocket = QString::fromLocal8Bit( argv[i] );
      RESIDUE| 			// Mark the whole process as agent-driven before the GUI or the
      RESIDUE| 			// engine exists: from here on no modal dialog may be opened, and
      RESIDUE| 			// the commands that raise one answer with a typed result instead
      RESIDUE| 			// (task #625, SPEC A13).
      RESIDUE| 			lmms::setAgentInstance( true );
      RESIDUE| 	// Opt-in agent control surface (SPEC A12). The socket is started before the
      RESIDUE| 	// engine so that a client can connect and probe (control.ping) while the
      RESIDUE| 	// instance is still initialising; commands that need the model return the
      RESIDUE| 	// typed 'busy' refusal until Engine::init() has run.
      RESIDUE| 	std::unique_ptr<ControlServer> controlServer;
      RESIDUE| 	if( !controlSocket.isEmpty() )
      RESIDUE| 		ControlRegistry* registry = ControlRegistry::instance();
      RESIDUE| 		controlServer = std::make_unique<ControlServer>( registry );
      RESIDUE| 		QString controlError;
      RESIDUE| 		if( !controlServer->listen( controlSocket, &controlError ) )
      RESIDUE| 			fprintf( stderr, "control socket: %s\n", controlError.toUtf8().constData() );
      RESIDUE| 		printf( "control socket listening on %s\n", controlSocket.toUtf8().constData() );
      RESIDUE| 		if( recoveryFilePresent && lmms::isUnattendedRun() )
      RESIDUE| 			// A modal here runs BEFORE app->exec(): in an unattended run
      RESIDUE| 			// (--control-socket, or no display at all) nobody can click it, so
      RESIDUE| 			// the instance would never become ready (task #625).  Take the
      RESIDUE| 			// box's own default button - "Recover", the non-destructive answer
      RESIDUE| 			// - and say so on stderr.
      RESIDUE| 			fprintf( stderr, "main: unattended run: recovering %s without the "
      RESIDUE| 				"\"Project recovery\" prompt (the prompt's default answer)\n",
      RESIDUE| 				recoveryFile.toUtf8().constData() );
      RESIDUE| 			fflush( stderr );
      RESIDUE| 		else if( recoveryFilePresent )
      RESIDUE| 	// The application is fully constructed and the initial project exists: from
      RESIDUE| 	// here the agent surface may drive the model (before this point every
      RESIDUE| 	// command returns the typed 'busy' refusal).
      RESIDUE| 	if( controlServer )
      RESIDUE| 		controlServer->registry()->setReady( true );
      RESIDUE| 		// A client may have asked to quit before startup finished (the socket is
      RESIDUE| 		// up first, by design). Apply it now that the normal shutdown path - and
      RESIDUE| 		// the main event loop - actually exist (task #626).
      RESIDUE| 		ControlRegistry::applyPendingQuit();
      RESIDUE| 	// The loop returned: the shutdown is doing its work, so disarm the
      RESIDUE| 	// last-resort guard (it must only ever catch a shutdown that never returns).
      RESIDUE| 	ControlRegistry::cancelShutdownGuard();
      RESIDUE| 	// Unlink the control socket here rather than at the end of main: the shutdown
      RESIDUE| 	// contract is "gone on exit", and this way it is gone before the engine
      RESIDUE| 	// teardown, which the agent may be watching (task #626).
      RESIDUE| 	if( controlServer )
      RESIDUE| 		controlServer->close();

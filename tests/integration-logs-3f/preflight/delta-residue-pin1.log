      RESIDUE| ProjectJournal::CheckPoint ProjectJournal::actionCheckPoint( std::function<void()> undo,
      RESIDUE| 	std::function<void()> redo )
      RESIDUE| 	CheckPoint step;
      RESIDUE| 	step.actions.append( qMakePair( std::move( undo ), std::move( redo ) ) );
      RESIDUE| 	return step;
      RESIDUE| //! Captures \a jo's current state, which becomes the redo half of a step.
      RESIDUE| void ProjectJournal::captureState( JournallingObject * jo, SavedObject * into ) const
      RESIDUE| 	DataFile currentState( DataFile::Type::JournalData );
      RESIDUE| 	jo->saveState( currentState, currentState.content() );
      RESIDUE| 	*into = SavedObject( jo->id(), currentState );
      RESIDUE| //! Restores one object from its saved XML, with journalling off so the restore
      RESIDUE| //! itself does not push a new checkpoint. The AutomationClip id fix-up is the
      RESIDUE| //! historical step that follows a restore that carried automation clips.
      RESIDUE| void ProjectJournal::restoreState( SavedObject & saved )
      RESIDUE| 	JournallingObject * jo = m_joIDs.value( saved.joID, nullptr );
      RESIDUE| 	if( jo == nullptr ) { return; }
      RESIDUE| 	const bool previous = isJournalling();
      RESIDUE| 	jo->restoreState( saved.data.content().firstChildElement() );
      RESIDUE| 	setJournalling( previous );
      RESIDUE| 	if( !saved.data.content().elementsByTagName( "automationclip" ).isEmpty() )
      RESIDUE| //! Restores every live object of \a step in one go (SPEC A16: one agent command
      RESIDUE| //! is one undoable step, however many objects it wrote).
      RESIDUE| bool ProjectJournal::restoreStep( CheckPoint & step, CheckPoint * redo )
      RESIDUE| 	bool restoredAny = false;
      RESIDUE| 	for( SavedObject & saved : step.objects )
      RESIDUE| 		JournallingObject * jo = m_joIDs.value( saved.joID, nullptr );
      RESIDUE| 		if( jo == nullptr ) { continue; }
      RESIDUE| 		SavedObject current;
      RESIDUE| 		captureState( jo, &current );
      RESIDUE| 		redo->objects.append( current );
      RESIDUE| 		restoreState( saved );
      RESIDUE| 		restoredAny = true;
      RESIDUE| 	return restoredAny;
      RESIDUE| 		CheckPoint redo;
      RESIDUE| 		// Objects first: an action may FREE one of them (deleting a MixerChannel
      RESIDUE| 		// frees its models, deleting a Track frees its clips), and a restore
      RESIDUE| 		// after the free would be a restore of a dead journal id.
      RESIDUE| 		bool did = restoreStep( c, &redo );
      RESIDUE| 		bool redoable = true;
      RESIDUE| 		for( int i = c.actions.size() - 1; i >= 0; --i )
      RESIDUE| 			// Undo is LIFO, so the recorded operations run in reverse push order
      RESIDUE| 			// and the redo record keeps them in push order.
      RESIDUE| 			const std::function<void()> undoAction = c.actions.at( i ).first;
      RESIDUE| 			const std::function<void()> redoAction = c.actions.at( i ).second;
      RESIDUE| 			if( !undoAction ) { continue; }
      RESIDUE| 			if( redoAction ) { redo.actions.prepend( qMakePair( undoAction, redoAction ) ); }
      RESIDUE| 			else { redoable = false; }
      RESIDUE| 			undoAction();
      RESIDUE| 			did = true;
      RESIDUE| 		if( !did ) { continue; }
      RESIDUE| 		if( redoable ) { m_redoCheckPoints.push( redo ); }
      RESIDUE| 		else { m_redoCheckPoints.clear(); }
      RESIDUE| 		CheckPoint undoState;
      RESIDUE| 		bool did = restoreStep( c, &undoState );
      RESIDUE| 		for( int i = c.actions.size() - 1; i >= 0; --i )
      RESIDUE| 			const std::function<void()> redoAction = c.actions.at( i ).second;
      RESIDUE| 			if( !redoAction ) { continue; }
      RESIDUE| 			undoState.actions.prepend( c.actions.at( i ) );
      RESIDUE| 			redoAction();
      RESIDUE| 			did = true;
      RESIDUE| 		if( !did ) { continue; }
      RESIDUE| 		m_undoCheckPoints.push( undoState );
      RESIDUE| 	if( !isJournalling() ) { return; }
      RESIDUE| 	trimUndoStack();
      RESIDUE| void ProjectJournal::addJournalCheckPoint( const QVector<JournallingObject *> &objects )
      RESIDUE| 	if( !isJournalling() ) { return; }
      RESIDUE| 	// One checkpoint, N objects: undo() pops it once and restores all of them,
      RESIDUE| 	// which is what makes one agent command one Ctrl+Z (SPEC A16).
      RESIDUE| 	CheckPoint step;
      RESIDUE| 	for( JournallingObject * jo : objects )
      RESIDUE| 		if( jo == nullptr ) { continue; }
      RESIDUE| 		SavedObject saved;
      RESIDUE| 		captureState( jo, &saved );
      RESIDUE| 		step.objects.append( saved );
      RESIDUE| 	if( step.objects.isEmpty() ) { return; }
      RESIDUE| 	m_undoCheckPoints.push( step );
      RESIDUE| 	trimUndoStack();
      RESIDUE| void ProjectJournal::addJournalAction( std::function<void()> undoAction, std::function<void()> redoAction )
      RESIDUE| 	if( !isJournalling() || !undoAction ) { return; }
      RESIDUE| 	m_undoCheckPoints.push( actionCheckPoint( std::move( undoAction ), std::move( redoAction ) ) );
      RESIDUE| 	trimUndoStack();
      RESIDUE| void ProjectJournal::trimUndoStack()
      RESIDUE| void ProjectJournal::mergeCheckpointsFrom( int depth )
      RESIDUE| 	if( depth < 0 || depth > m_undoCheckPoints.size() ) { return; }
      RESIDUE| 	const int excess = m_undoCheckPoints.size() - depth;
      RESIDUE| 	if( excess <= 1 ) { return; }
      RESIDUE| 	// For each OBJECT, the earliest capture wins: that is the state before the
      RESIDUE| 	// command, and restoring a later capture would undo only part of it.
      RESIDUE| 	CheckPoint merged;
      RESIDUE| 	QSet<jo_id_t> seen;
      RESIDUE| 	for( int i = depth; i < m_undoCheckPoints.size(); ++i )
      RESIDUE| 		const CheckPoint & step = m_undoCheckPoints.at( i );
      RESIDUE| 		for( const SavedObject & saved : step.objects )
      RESIDUE| 			if( seen.contains( saved.joID ) ) { continue; }
      RESIDUE| 			seen.insert( saved.joID );
      RESIDUE| 			merged.objects.append( saved );
      RESIDUE| 		// Every recorded operation is kept, in push order.
      RESIDUE| 		merged.actions += step.actions;
      RESIDUE| 	if( merged.empty() ) { m_undoCheckPoints.remove( depth, excess ); return; }
      RESIDUE| 	m_undoCheckPoints.remove( depth, excess );
      RESIDUE| 	m_undoCheckPoints.push( merged );

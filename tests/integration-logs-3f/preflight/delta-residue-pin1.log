      RESIDUE| #include <functional>
      RESIDUE| #include <QVector>
      RESIDUE| 	/*! One undo step covering SEVERAL objects (Zene Studio, SPEC A16).
      RESIDUE| 	 * undo() pops ONE checkpoint, so N checkpoints cost N Ctrl+Z presses. An
      RESIDUE| 	 * agent command that writes more than one object - track.set_solo writes
      RESIDUE| 	 * every track's mute through TrackView - must nevertheless be ONE undoable
      RESIDUE| 	 * step for the human, so its before-states are recorded as one checkpoint
      RESIDUE| 	 * and restored together. Additive: the single-object call above is the
      RESIDUE| 	 * one-entry case of this and its behaviour is unchanged.
      RESIDUE| 	void addJournalCheckPoint( const QVector<JournallingObject *> &objects );
      RESIDUE| 	/*! One undo step that RUNS AN ACTION instead of restoring an object
      RESIDUE| 	 * (Zene Studio, SPEC A16).
      RESIDUE| 	 * A created or deleted Track/MixerChannel has no live object a checkpoint
      RESIDUE| 	 * could restore - a deleted JournallingObject's id resolves to nullptr and
      RESIDUE| 	 * a created one has nothing to put back - so the inverse is the operation,
      RESIDUE| 	 * not the state. Pushing it here (rather than into a second undo stack kept
      RESIDUE| 	 * by the control surface) is what makes Ctrl+Z and control.undo one
      RESIDUE| 	 * history. `redo` is the reverse action, so a redo is faithful rather than
      RESIDUE| 	 * a dropped step. Both actions run on the UI thread; nothing here is
      RESIDUE| 	 * reached from the audio thread.
      RESIDUE| 	void addJournalAction( std::function<void()> undo, std::function<void()> redo );
      RESIDUE| 	/*! Marks the current undo depth, and merges everything pushed since into
      RESIDUE| 	 * ONE step (Zene Studio, SPEC A16 deliverable 3).
      RESIDUE| 	 * This is the mechanism that makes "one agent command = one Ctrl+Z" true in
      RESIDUE| 	 * general rather than per command. AutomatableModel::setValue() pushes a
      RESIDUE| 	 * checkpoint of its own on every non-automated write
      RESIDUE| 	 * (src/core/AutomatableModel.cpp:303), so a single command that writes N
      RESIDUE| 	 * models - track.set_solo writes the solo flag and every other track's mute -
      RESIDUE| 	 * leaves N checkpoints on the stack and costs N undos. The control registry
      RESIDUE| 	 * therefore marks the depth before a mutating handler runs and merges
      RESIDUE| 	 * afterwards: for each object, its EARLIEST capture wins (that is the
      RESIDUE| 	 * pre-command state), and every recorded action is kept in push order.
      RESIDUE| 	int undoDepth() const { return m_undoCheckPoints.size(); }
      RESIDUE| 	void mergeCheckpointsFrom( int depth );
      RESIDUE| 	//! One (object, saved state) pair of a checkpoint.
      RESIDUE| 	struct SavedObject
      RESIDUE| 		SavedObject( jo_id_t initID = 0,
      RESIDUE| 	};
      RESIDUE| 		//! An empty step: an action-only step, or a redo record being filled.
      RESIDUE| 		CheckPoint() = default;
      RESIDUE| 		//! A step restoring one object (the historical checkpoint shape).
      RESIDUE| 		CheckPoint( jo_id_t initID, const DataFile& initData ) :
      RESIDUE| 			objects(),
      RESIDUE| 			actions()
      RESIDUE| 			objects.append( SavedObject( initID, initData ) );
      RESIDUE| 		//! The objects this step restores, together, in one pop.
      RESIDUE| 		QVector<SavedObject> objects;
      RESIDUE| 		//! Operations this step runs, in push order, each paired with its
      RESIDUE| 		//! reverse. Undo runs the firsts in reverse push order, redo the
      RESIDUE| 		//! seconds; a step whose second is empty cannot be redone, and the
      RESIDUE| 		//! redo stack is emptied rather than replaying an older entry.
      RESIDUE| 		QVector<QPair<std::function<void()>, std::function<void()>>> actions;
      RESIDUE| 		bool hasActions() const { return !actions.isEmpty(); }
      RESIDUE| 		bool empty() const { return objects.isEmpty() && actions.isEmpty(); }
      RESIDUE| 	};
      RESIDUE| 	//! An action-only step: runs \a undo, and on redo runs \a redo.
      RESIDUE| 	static CheckPoint actionCheckPoint( std::function<void()> undo,
      RESIDUE| 		std::function<void()> redo = std::function<void()>() );
      RESIDUE| 	//! Drops the oldest steps once the stack exceeds MAX_UNDO_STATES.
      RESIDUE| 	void trimUndoStack();
      RESIDUE| 	//! Restores every live object of \a step, capturing the redo halves into
      RESIDUE| 	//! \a redo. False when no object of the step is still alive (the caller then
      RESIDUE| 	//! pops the next checkpoint, the historical behaviour). Non-const because
      RESIDUE| 	//! DataFile::content() is: the step is the caller's own copy, popped off the
      RESIDUE| 	//! stack, so modifying it in place is safe.
      RESIDUE| 	bool restoreStep( CheckPoint & step, CheckPoint * redo );
      RESIDUE| 	//! Captures \a jo's current state into \a into (the redo half of a step).
      RESIDUE| 	void captureState( JournallingObject * jo, SavedObject * into ) const;
      RESIDUE| 	//! Restores \a saved into its object, journalling off.
      RESIDUE| 	void restoreState( SavedObject & saved );

@@ -0,0 +1,166 @@
+/*
+ * ControlEdit.h - shared helpers for the notes / clips / tracks command groups
+ *                 of the agent control surface (SPEC-zene-studio.md A11-A16).
+ *
+ * Copyright (c) 2026 Zene Studio contributors
+ *

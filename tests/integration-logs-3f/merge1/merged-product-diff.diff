+++ b/src/core/ControlAutomationSupport.cpp
@@ -0,0 +1,336 @@
+/*
+ * ControlAutomationSupport.cpp - shared helpers for the automation.* command
+ *                                group (SPEC A11-A16).
+ *
+ * Copyright (c) 2026 Zene Studio contributors
+ *
+ * This file is part of LMMS - https://lmms.io

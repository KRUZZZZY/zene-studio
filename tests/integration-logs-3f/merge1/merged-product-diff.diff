+ * Boston, MA 02110-1301 USA.
+ */
+
+#include "ControlDeviceSupport.h"
+
+#include <QCryptographicHash>
+#include <QFile>
+#include <QFileInfo>
+#include <QSaveFile>
+#include <QTextStream>
+
